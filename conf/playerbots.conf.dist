#

# Distances are in yards
AiPlayerbot.FarDistance = 20.0
AiPlayerbot.SightDistance = 100.0
AiPlayerbot.SpellDistance = 28.5
AiPlayerbot.ShootDistance = 5.0
AiPlayerbot.HealDistance = 38.5
AiPlayerbot.LootDistance = 15.0
AiPlayerbot.FleeDistance = 5.0
AiPlayerbot.AggroDistance = 22
AiPlayerbot.TooCloseDistance = 5.0
AiPlayerbot.MeleeDistance = 0.75
AiPlayerbot.FollowDistance = 1.5
AiPlayerbot.WhisperDistance = 6000.0
AiPlayerbot.ContactDistance = 0.45
AiPlayerbot.AoeRadius = 10
AiPlayerbot.RpgDistance = 200
AiPlayerbot.GrindDistance = 75.0
AiPlayerbot.ReactDistance = 150.0

#
#
####################################################################################################

####################################################################################################
# THRESHOLDS
#

# Health/Mana levels
AiPlayerbot.CriticalHealth = 25
AiPlayerbot.LowHealth = 45
AiPlayerbot.MediumHealth = 65
AiPlayerbot.AlmostFullHealth = 85
AiPlayerbot.LowMana = 15
AiPlayerbot.MediumMana = 40
AiPlayerbot.HighMana = 65

#
#
####################################################################################################

####################################################################################################
# QUESTS
#

# Bots pick their quest rewards
# yes = picks the most useful item, no = list all rewards, ask = pick useful item and lists if multiple
AiPlayerbot.AutoPickReward = yes

# Sync quests with player (bots will complete quests the moment you hand them in and will not loot quest items.)
# Default: 1 (enabled)
AiPlayerbot.SyncQuestWithPlayer = 1

# Bots will auto-complete quests for the player when handing in bots' quests
# Default: 0 (disabled)
AiPlayerbot.SyncQuestForPlayer = 0

# Bots take the quests their master accepts: when you accept a quest, every bot of your group
# whose master you are and who stands on your map accepts it too, if it can take it.
# Default: 1 (enabled)
AiPlayerbot.SyncQuestAcceptWithPlayer = 1

# How far (yards) the CoA Companion bot quest list looks for quest givers around the player.
# It lists the quests only some of your bots can take: class quests, and race and profession
# quests on demand. Range 50-2000.
# Default: 300
AiPlayerbot.NearbyQuestRadius = 300

# Seconds between an alt bot's ".rbank deposit all": alt bots put the reagents they loot into the
# reagent bank (mod-reagent-bank-account) as the ReagentBankUI addon does for a played character.
# Random bots never do. 0 disables it, otherwise at least 10.
# Default: 30
AiPlayerbot.AltBotReagentDepositInterval = 30

# Bots will drop obsolete quests
# Default: 1 (enabled)
AiPlayerbot.DropObsoleteQuests = 1

#
#
####################################################################################################

####################################################################################################
# COMBAT
#

# Auto add dungeon/raid strategies when entering the instance if implemented
AiPlayerbot.ApplyInstanceStrategies = 1

# Enable auto avoid aoe strategy
# Default: 1 (enabled)
AiPlayerbot.AutoAvoidAoe = 1

# Only avoid aoe spells with a radius smaller than this value
AiPlayerbot.MaxAoeAvoidRadius = 15.0

# A whitelist of aoe spell IDs that should not be avoided
AiPlayerbot.AoeAvoidSpellWhitelist = 50759,57491,13810,29946

# Enable healer bot save mana strategy
# Default: 1 (enabled)
AiPlayerbot.AutoSaveMana = 1

# Healer bot save mana threshold
# Default: 60 (60%)
AiPlayerbot.SaveManaThreshold = 60

# Enable Paladin bots to use greater blessings, with the blessing used being based on the
# number of Paladins in the raid/group and the spec of the recipient. Priorities for each
# spec are hardcoded in GreaterBlessingActions.h.
# 0 = disabled
# 1 = enabled in raid groups only
# 2 = enabled in all groups
# Default: 1 (raid only)
AiPlayerbot.AutoGreaterBlessings = 1

# Enable bots to use group reagent buffs: Gift of the Wild, Arcane Brilliance,
# Prayer of Fortitude, Prayer of Spirit, and Prayer of Shadow Protection.
# 0 = disabled
# 1 = enabled in raid groups only
# 2 = enabled in all groups
# Default: 2 (all groups)
AiPlayerbot.AutoPartyBuffs = 2

# Bots tell the group when they attempt to use a reagent-based greater blessing or group buff
# but have to fall back to the single-target version because they are out of reagents.
# Default: 1 (enabled)
AiPlayerbot.TellWhenMissingBuffReagents = 1

# Cooldown for the missing buff reagent message, in seconds.
# Default: 300 (5 minutes)
AiPlayerbot.MissingBuffReagentMessageCooldown = 300

# When a ready check is issued out of combat, bots refresh missing/short buffs before reporting ready.
# A bot that still has buff work it can perform stays not-ready until the ready check ends; this
# includes missing reagents (the cast is attempted and fails). Uses the always-on "force rebuff"
# strategy: bots with strategy sets saved before this feature keep their saved set - reset their
# strategies or use "nc +force rebuff" to opt them in. The "rebuff" chat command starts the same
# buff pass without a ready check and works regardless of this setting.
# Default: 0 (disabled)
AiPlayerbot.ForceRebuffOnReadyCheck = 0

# During a force-rebuff pass (ready check or the "rebuff" command), a buff is topped off (recast)
# once it drops more than this many seconds below its full duration, so buffs are refreshed toward
# maximum remaining time to last the fight. The effective margin never drops below the time the
# pass has already run, so small values are safe.
# Default: 60
AiPlayerbot.ForceRebuffMarginSecs = 60

# Bots can flee from enemies
AiPlayerbot.FleeingEnabled = 1

#
#
####################################################################################################

####################################################################################################
# CHEATS
#

# Enable/Disable maintenance command
# Learn all available spells and skills, assign talent points, refresh consumables, repair, enchant equipment, socket gems, etc.
# Applies if bot's level is above AiPlayerbot.MinEnchantingBotLevel
# Default: 1 (enabled)
AiPlayerbot.MaintenanceCommand = 1

# Enable/Disable specific maintenance command functionality for altbots
# Disable to prevent players from giving free bags, spells, skill levels, etc. to their altbots
# Default: 1 (enabled)
AiPlayerbot.AltMaintenanceAmmo = 1
AiPlayerbot.AltMaintenanceFood = 1
AiPlayerbot.AltMaintenanceReagents = 1
AiPlayerbot.AltMaintenanceConsumables = 1
AiPlayerbot.AltMaintenancePotions = 1

AiPlayerbot.AltMaintenanceBags = 1
AiPlayerbot.AltMaintenanceMounts = 1
AiPlayerbot.AltMaintenanceSkills = 1

# "Special Spells" consist of any spells listed in AiPlayerbot.RandomBotSpellIds and Death Gate for Death Knights
AiPlayerbot.AltMaintenanceClassSpells = 1
AiPlayerbot.AltMaintenanceAvailableSpells = 1
AiPlayerbot.AltMaintenanceSpecialSpells = 1
AiPlayerbot.AltMaintenanceTalentTree = 1
AiPlayerbot.AltMaintenanceGlyphs = 1
AiPlayerbot.AltMaintenanceGemsEnchants = 1

AiPlayerbot.AltMaintenancePet = 1
AiPlayerbot.AltMaintenancePetTalents = 1

AiPlayerbot.AltMaintenanceReputation = 1
AiPlayerbot.AltMaintenanceAttunementQuests = 1
AiPlayerbot.AltMaintenanceKeyring = 1

# Enable/Disable autogear command, which automatically upgrades bots' gear
# The quality is limited by AutoGearQualityLimit and AutoGearScoreLimit
# In-game syntax (the argument can only request at or below the configured limits):
#   autogear            - gear to the configured AutoGearQualityLimit / AutoGearScoreLimit
#   autogear green      - cap quality to uncommon (also: white/common, blue/rare, purple/epic,
#                         orange/legendary, artifact, heirloom)
#   autogear match      - match the commanding player's average item level, computed over the slots the
#                         player actually has filled so empty slots do not drag the target down
#   autogear 200        - target a specific item level (clamped to AutoGearScoreLimit when that is non-zero).
#                         Only positive whole numbers are accepted; negative or malformed values are rejected
#   autogear reset      - erase all equipped gear and regear from scratch (combinable: autogear reset green,
#                         autogear reset 200, autogear reset match)
#   autogear bis        - separate BiS command, see AutoGearBisCommand below
# Default: 1 (enabled)
AiPlayerbot.AutoGearCommand = 1

# Enable/Disable autogear command on altbots
# Default: 1 (enabled)
AiPlayerbot.AutoGearCommandAltBots = 1

# Self-found mode, up to CoaSelfFoundMaxLevel: no bot (random or alt) of that level range is given gear, gems or
# enchantments by the server. Bots wear only what they loot, earn from quests or are traded, and random bots gain
# levels only by playing (no random level, no level brackets, no level reset). Autogear, bis and init commands are
# refused; addon recruiting only picks bots already near your level. Consumables, ammo, reagents, food and bags are
# still provided. Above CoaSelfFoundMaxLevel bots are geared as usual for the endgame.
# With 1, new bots start at a low level and the bot world grows up slowly. Switching an existing world to 1
# keeps every bot's current level and gear.
# Default: 0 (disabled)
AiPlayerbot.CoaSelfFound = 0

# Highest level self-found applies to; at higher levels bots are geared and recruited as usual.
# Default: 59 (at 60 bots are geared as usual for the endgame)
AiPlayerbot.CoaSelfFoundMaxLevel = 59

# Self-found random bots in dungeons: share of the random bots (0 to 100 percent, picked by character whatever
# its level, always the same ones) that wear only what they loot, earn from quests or are traded from level 10 on.
# No gear, gems, enchantments, level roll or level bracket is given to them, and the autogear and bis commands are
# refused. With mod-dungeon-clear, parties of five self-found bots clear the dungeons of their level (RFC at 13-18,
# Wailing Caverns and Deadmines around 20, ... up to the level 60 dungeons), with at most this share of the online
# random bots in dungeons at once: DungeonClear.SelfFound.* in mod_dungeon_clear.conf. On a self-found realm
# (AiPlayerbot.CoaSelfFound = 1) every bot up to CoaSelfFoundMaxLevel is self-found already: the share then only
# says how many go to dungeons, and keeps them self-found at level 60 too.
# Players' characters and alts are never in the share.
#    -1 - automatic: 20 when AiPlayerbot.CoaSelfFound = 1 (Solo self-found), 0 otherwise
#     0 - disabled: every random bot is geared as usual and no self-found party is formed
# 1-100 - this share, whatever AiPlayerbot.CoaSelfFound
# Default: -1 (automatic)
AiPlayerbot.CoaSelfFoundBotsPercent = -1

# Random bot transmog: random bots show other models of their armor and weapon types, picked from a whole item
# set when one fits, with a required level up to 15 below their own. Purely visual: their real gear and stats never
# change and nothing is saved; a bot keeps the same look at every login until its level changes bracket.
# Not applied to alt bots, to self-found levels (CoaSelfFound), or when CoA.CollectionsForBots >= 2.
# Default: 1 (enabled)
AiPlayerbot.RandomBotTransmog = 1

# Share of random bots that use a transmog, in percent; the same bots every time.
# Default: 50
AiPlayerbot.RandomBotTransmogPercent = 50

# Random bots below this level keep their real gear look.
# Default: 10
AiPlayerbot.RandomBotTransmogMinLevel = 10

# If 1 (enabled) chat command: autogear bis, gives bots BiS gear from the playerbots_bis_gear table
# whose item-level floor matches AutoGearScoreLimit (e.g. 290 = ICC, 245 = ToC,
# 125 = Kara, 78 = MC). See the AutoGearScoreLimit comment below for the full list.
# chat command: autogear bis x, (x must be positive integer) will give items based on value of x.
# If x is bigger than AutoGearScoreLimit, bis wont be given, if lower it will match x when giving items.
# Commands falls back to autogear when no tier matches or the table is empty for the bot's class/spec.
# Requires AutoGearQualityLimit = 4 and AutoGearCommand = 1.
# If AutoGearCommandAltBots = 1 it will be anbled for alt bots.
# Default: 0 (disabled)
AiPlayerbot.AutoGearBisCommand = 0

# Equipment quality limitation for autogear command (1 = normal, 2 = uncommon, 3 = rare, 4 = epic, 5 = legendary)
# Default: 3 (rare)
AiPlayerbot.AutoGearQualityLimit = 3

# Equipment item level (not gearscore) limitation for autogear command (0 = no limit)
# Classic
# Max iLVL Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# Max iLVL Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# TBC
# Max iLVL Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# Max iLVL Phase 1(Kara, Gruul, Mag) = 125 | Phase 2(SSC, TK, ZA) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# WotLK
# Max iLVL Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# Max iLVL Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# Default: 0 (no limit)
AiPlayerbot.AutoGearScoreLimit = 0

# Enable/Disable cheats for bots
# "food" (bots eat or drink without using food or drinks from their inventory)
# "gold" (bots have infinite gold)
# "health" (bots immediately regenerate lost health)
# "mana" (bots have infinite mana)
# "power" (bots have infinite energy, rage, and runic power)
# "taxi" (bots may use all flight paths, though they will not actually learn them)
# "raid" (bots use certain cheats implemented into raid strategies)
# To use multiple cheats, separate them by commas below (e.g., to enable all, use "gold,health,mana,power,raid,taxi")
# Default: food, taxi, and raid are enabled
AiPlayerbot.BotCheats = "food,taxi,raid"

# List of attunement quests (comma-separated list of quest IDs) that are automatically completed for all bots.
# While mod-playerbots does not restore removed attunement requirements, other mods, such as mod-individual-progression, may do so.
# This is meant to exclude bots from such requirements.
#
# Defaults:
# Caverns of Time - Part 1
# - 10279, To The Master's Lair
# - 10277, The Caverns of Time
# Caverns of Time - Part 2 (Escape from Durnholde Keep)
# - 10282, Old Hillsbrad
# - 10283, Taretha's Diversion
# - 10284, Escape from Durnholde
# - 10285, Return to Andormu
# Caverns of Time - Part 2 (The Black Morass)
# - 10296, The Black Morass
# - 10297, The Opening of the Dark Portal
# - 10298, Hero of the Brood
# Magister's Terrace
# - 11481, Crisis at the Sunwell
# - 11482, Duty Calls
# - 11488, Magisters' Terrace
# - 11490, The Scryer's Scryer
# - 11492, Hard to Kill
# Serpentshrine Cavern
# - 10901, The Cudgel of Kar'desh
# Tempest Keep: The Eye
# - 10888, Trial of the Naaru: Magtheridon
# Battle for Mount Hyjal (Hyjal Summit)
# - 10445, The Vials of Eternity
# Black Temple
# - 10985, A Distraction for Akama
AiPlayerbot.AttunementQuests = 10279,10277,10282,10283,10284,10285,10296,10297,10298,11481,11482,11488,11490,11492,10901,10888,10445,10985

#
#
####################################################################################################

####################################################################################################
# FLIGHTPATH
#

# Min random delay before the 1st follower bot clicks the flight-master (ms)
AiPlayerbot.BotTaxiDelayMinMs = 350

# Upper bound for the overall taxi delay window (ms) – larger spreads big raids
AiPlayerbot.BotTaxiDelayMaxMs = 5000

# Fixed gap added per group-slot so bots never take off together (ms)
AiPlayerbot.BotTaxiGapMs = 200

# Extra small randomness added to each gap so launches don’t look robotic (ms)
AiPlayerbot.BotTaxiGapJitterMs = 100

#
#
####################################################################################################

####################################################################################################
# PROFESSIONS
#

# Percentage of randombots in each class bucket that receive a class-matching
# weighted profession combination. The remaining randombots use the weighted
# random sane-pair profession pool.
# Default: 30
AiPlayerbot.ClassMatchingProfessionChance = 30

# Automatically adds the 'master fishing' strategy to bots that have the fishing skill when the bots master fishes.
# Default: 1 (Enabled)
AiPlayerbot.EnableFishingWithMaster = 1

# Distance from itself (in yards) that a bot with a master will search for water to fish
AiPlayerbot.FishingDistanceFromMaster = 10.0

# Distance from itself (in yards) that a bot without a master will search for water to fish
# Currently not relevant since masterless bots will not fish
AiPlayerbot.FishingDistance = 40.0

# Distance from water (in yards) beyond which a bot will remove the 'master fishing' strategy
AiPlayerbot.EndFishingWithMaster = 30.0

#
#
####################################################################################################

#######################################
#                                     #
# RANDOMBOT-SPECIFIC SETTINGS         #
#                                     #
#######################################

####################################################################################################
# GENERAL
#

# Enable/Disable randomly generated password for randombot accounts
AiPlayerbot.RandomBotRandomPassword = 0

# Minimum and maximum levels for randombots
AiPlayerbot.RandomBotMinLevel = 1
AiPlayerbot.RandomBotMaxLevel = 60

# Sync max randombot level with max level of online players
# Default: 0 (disabled)
AiPlayerbot.SyncLevelWithPlayers = 0

# Concentrate randombots teleporting into level-appropriate open-world zones that hold a real
# (non-GM) player. Falls back to normal teleporting behaviour when no player's zone matches.
# Best paired with AiPlayerbot.SyncLevelWithPlayers.
# Default: 0 (disabled)
AiPlayerbot.RandomBotConcentrateInPlayerZone = 0

# Mark many quests ≤ bot level as complete (slows down bot creation)
# Default: 0 (disabled)
AiPlayerbot.PreQuests = 0

# Enable LFG for randombots
# Default: 1 (enabled)
AiPlayerbot.RandomBotJoinLfg = 1

# Enable/Disable periodic online - offline of randombots to mimic the real-world scenario where not all players are online simultaneously
# When enabled, randombots are randomly selected to go online or offline periodically from a larger set
# Default: 0 (disabled, the set of online bots remains fixed)
AiPlayerbot.EnablePeriodicOnlineOffline = 0

# Defines the ratio between the total number of randombots (including offline ones) and the number of randombots currently online (MaxRandomBots)
# This setting must greater than 1.0 and only applies when EnablePeriodicOnlineOffline
# Default: 2.0 (total number of bots is twice the number of MaxRandomBots)
AiPlayerbot.PeriodicOnlineOfflineRatio = 2.0

# With EnablePeriodicOnlineOffline, the bots that go online are first taken among those within LevelWindow levels of a
# real player online (several players: any of their windows), then at random. Bots are never re-leveled: only the
# choice of who goes online changes. No real player online: random choice, as before.
# Default: 0 (disabled), LevelWindow 5
AiPlayerbot.OnlineSelection.FollowPlayerLevels = 0
AiPlayerbot.OnlineSelection.LevelWindow = 5

# Percentage ratio of Alliance and Horde randombots
AiPlayerbot.RandomBotAllianceRatio = 50
AiPlayerbot.RandomBotHordeRatio = 50

# Disable logging in of death knight bots
AiPlayerbot.DisableDeathKnightLogin = 0

# Enable simulated expansion limitation for talents and glyphs
# If enabled, limits talent trees to 6 rows plus the middle talent of the 7th row for bots until level 61
# and 8 rows plus the middle talent of the 9th row for bots from level 61 until level 71
# Default: 0 (disabled)
AiPlayerbot.LimitTalentsExpansion = 0

# Configure randombot trading (0: Disabled, 1: Enabled, 2: Only Buy, 3: Only Sell)
# Default: 1 (enabled)
AiPlayerbot.EnableRandomBotTrading = 1

# Configure message prefixes which will be excluded in analysis in trade action to open trade window
AiPlayerbot.TradeActionExcludedPrefixes = "RPLL_H_,DBMv4,{звезда} Questie,{rt1} Questie"

# Allow bots to send mail. When disabled, bots will not mail items or money in
# response to chat commands ("send mail").
# Default: 1 (enabled)
AiPlayerbot.BotSendMailEnabled = 1

#
#
####################################################################################################

####################################################################################################
# LEVELS
#

# Disable randombots being generated with a random level
# If disabled, every randombot starts on a specified level (but can still level up by killing mobs and questing)
AiPlayerbot.DisableRandomLevels = 0

# Set randombots' starting level here if "AiPlayerbot.DisableRandomLevels" is enabled
AiPlayerbot.RandombotStartingLevel = 1

# Chance randombot has min level on first randomize
# Default: 0.1 (10%)
AiPlayerbot.RandomBotMinLevelChance = 0.1

# Chance randombot has max level on first randomize
# Default 0.1 (10%)
AiPlayerbot.RandomBotMaxLevelChance = 0

# Fix the level of randombots (they won't level up)
# Default: 0 (disabled)
AiPlayerbot.RandomBotFixedLevel = 0

# Set RandomBotMaxLevel bots to RandomBotMinLevel
# Default: 0 (disabled)
AiPlayerbot.DowngradeMaxLevelBot = 0

# Set XP rate for randombots (Default: 1.0)
# Server XP Rate * AiPlayerbot.RandomBotXPRate
AiPlayerbot.RandomBotXPRate = 1.0

#
#
####################################################################################################

####################################################################################################
# RANDOM BOT LEVEL MANAGEMENT (LEVEL BRACKETS + LEVEL RESET)
#
# Two independent, opt-in sub-features for managing random bot levels over time. Both pick up
# changed values on the standard ".reload config" GM command.
#
#   - Level Brackets: periodically redistributes random bots across configurable per-faction level
#     brackets, optionally weighting the distribution toward brackets that contain real (non-bot)
#     players. This complements AiPlayerbot.DowngradeMaxLevelBot-style behavior: instead of a
#     one-shot downgrade, it continuously rebalances the whole random bot population across brackets
#     over time.
#
#   - Level Reset: when a random bot reaches a configured max level, resets it back down to a lower
#     level via a full PlayerbotFactory randomize, with an optional percent chance (optionally
#     scaled by level), an optional minimum played-time restriction, and an optional "skip" that
#     sends a bot straight to a different level as soon as it reaches a configured trigger level.
#
# NOTE: Level Reset overlaps with AiPlayerbot.DowngradeMaxLevelBot, which downgrades a bot that is
#       already at RandomBotMaxLevel to RandomBotMinLevel the next time it is periodically
#       re-randomized. Level Reset instead acts immediately (or on a played-time timer) as soon as a
#       bot reaches the configured level, with its own chance/played-time controls. Do not normally
#       enable both AiPlayerbot.DowngradeMaxLevelBot and AiPlayerbot.ResetBotLevel.Enabled at the
#       same time.
#

##############################################
# Level Brackets
##############################################

# Enables the level brackets feature.
# CoA: on by default, with narrow brackets up to 30 (1-3 alone) so starting and levelling zones stay
# populated - under dynamic distribution every bracket weighs the same, so narrower brackets
# at low level mean more bots there (6 of 9 brackets = about two thirds of the bots in 1-30).
# Default: 1 on the CoA branch (0 upstream)
AiPlayerbot.LevelBrackets.Enabled = 1

# The frequency (in seconds) at which the bot level distribution check is performed.
# Default: 300
AiPlayerbot.LevelBrackets.CheckFrequency = 300

# The frequency (in seconds) at which pending level resets are processed for safe bots and flagged
# bots that failed safety checks initially.
# Default: 15
AiPlayerbot.LevelBrackets.CheckFlaggedFrequency = 15

# Maximum number of flagged bots to process per pending level change step.
# 0 = unlimited (process all flagged bots each step)
# Default: 5
AiPlayerbot.LevelBrackets.FlaggedProcessLimit = 5

# When enabled, bots in a guild led by a real (non-bot) player are excluded from bot bracket
# calculations and will not be level changed or flagged. Backed by the shared PlayerbotGuildMgr
# guild cache (validated at startup and refreshed hourly), which also covers offline players; a
# guild counts as real when its leader is not a random-bot account.
# Default: 1 (enabled)
AiPlayerbot.LevelBrackets.IgnoreGuildBotsWithRealPlayers = 1

# When enabled, bots that are members of arena teams are excluded from bot bracket calculations
# and will not be level changed or flagged. This prevents bots in arena teams from being changed,
# which would break team compositions.
# Default: 1 (enabled)
AiPlayerbot.LevelBrackets.IgnoreArenaTeamBots = 1

# Ignore bots that are on real players' friends lists from any brackets.
# Default: 1 (enabled)
AiPlayerbot.LevelBrackets.IgnoreFriendListed = 1

# Comma-separated list of bot names to exclude from all bracket checks. Names must match the
# character name exactly (character names are stored capitalized, e.g. "Thrall").
# Default: ""
AiPlayerbot.LevelBrackets.ExcludeNames =

# A bot moved into the lowest bracket starts over as a new character would: at that bracket's
# first level, at its race's starting point. A bot moved to any other level is sent to a place
# for its new level. Starting zones then keep seeing level 1 newcomers while the bots already
# there level up and move on.
# Default: 1 on the CoA branch (0 upstream)
AiPlayerbot.LevelBrackets.FreshStart = 1

# With FreshStart, send the newcomers to the starting areas of their faction in turn rather than
# to their own race's, so every starting valley gets as many (humans have one to themselves).
# Default: 1 on the CoA branch (0 upstream)
AiPlayerbot.LevelBrackets.FreshStartSpread = 1

# The number of level brackets used for bot distribution. Both Alliance and Horde should have the
# same number of brackets defined below.
# Default: 9
#
# IMPORTANT: If you extend the number of brackets beyond 9, you must add configuration lines for
#            the additional bracket lines below (e.g. Range10, Range11, etc.) to both your
#            playerbots.conf and this playerbots.conf.dist. Ensure that the sum of the Pct values
#            for each faction remains 100.
# Conquest of Azeroth: eight brackets on the battleground ones (1-9 ... 50-59, 60), most bots at the
# top levels, so that battlegrounds start and raids fill on both sides.
AiPlayerbot.LevelBrackets.NumRanges = 8

# Enables dynamic recalculation of bot distribution percentages based on the number of non-bot
# players present in each level bracket. This overrides any custom brackets in the conf.
# Default: 0 (disabled)
AiPlayerbot.LevelBrackets.Dynamic.UseDynamicDistribution = 0

# Controls how much extra weight is given to brackets (level ranges) that contain real (non-bot)
# players, when dynamic distribution is enabled. The higher this value, the more bots move to the
# same level brackets where real players are found, but the effect is gentle, not extreme. A value
# of 0.0 means bots always distribute evenly across all brackets, regardless of where players are.
# The default value of 1.0 gives a mild, balanced effect. Raising this to 3.0, 5.0, or higher makes
# bots concentrate more in brackets with real players. The value is a multiplier (not a percent):
# 0.0 = no extra effect, 1.0 = minimal, 3.0 = stronger, 5.0 = strong but not extreme. Experiment
# based on your total bot count and real player counts to find a good number for your server. If
# you want a large congestion of bots in your level bracket for solo play, 10-15 is recommended.
# What to expect:
#   - With 1.0 (default): if 6/10 real players are in one bracket, that bracket gets about 12.77%
#     of bots. All-empty brackets get about 10.69% each.
#   - With 3.0: same scenario: bracket gets about 15.73% of bots. All-empty brackets: 9.93% each.
#   - With 5.0: bracket with 6/10 real players gets 18.31%. All-empty brackets: 9.28% each.
#   - If all real players are in one bracket and weight is 5.0, that bracket gets about 21.56% of
#     bots (others: 9.80% each).
#   - With 0.0: every bracket always gets the same number of bots (e.g., 11.11% each for 9
#     brackets).
# Formula (per bracket):
#   bracket_weight = 1.0 + (RealPlayerWeight x (1 / TotalRealPlayers) x log(1 + RealPlayersInBracket))
#   All bracket weights are normalized to total 100%.
# Default: 1.0
AiPlayerbot.LevelBrackets.Dynamic.RealPlayerWeight = 3.0

# If enabled, both Alliance and Horde must have identical bracket definitions (same number, same
# level bounds). All real players (regardless of faction) influence the dynamic distribution for
# both factions.
# Default: 0 (disabled)
# NOTE: If the brackets do not match when enabled, SyncFactions is forcibly disabled for that
#       session and an error is logged; the server will not fail to start over this.
AiPlayerbot.LevelBrackets.Dynamic.SyncFactions = 0

##############################################
# Alliance Level Brackets Configuration
##############################################
# The following settings define the level brackets for Alliance bots. For each bracket, specify:
#
#    AiPlayerbot.LevelBrackets.Alliance.RangeX.Lower
#        Description: The lower bound (inclusive) of bracket X.
#
#    AiPlayerbot.LevelBrackets.Alliance.RangeX.Upper
#        Description: The upper bound (inclusive) of bracket X.
#
#    AiPlayerbot.LevelBrackets.Alliance.RangeX.Pct
#        Description: The desired percentage of Alliance bots that should fall into bracket X.
#
# EXAMPLE:
#   The default configuration below defines 9 brackets: Range1 covers levels 1-9, Range2 covers
#   levels 10-19, Range3 covers levels 20-29, and so on.
#
#   To customize or add a new bracket (for example, to isolate level 60 in its own bracket):
#       - Set Range7.Lower = 60 and Range7.Upper = 60, then adjust the Pct values for Range6 and
#         Range8 accordingly.
#
#   To add an extra bracket beyond the default 9:
#       1. Increase AiPlayerbot.LevelBrackets.NumRanges to the desired number.
#       2. Add configuration lines for the new RangeX.Lower, RangeX.Upper, and RangeX.Pct.
#
# NOTE: The sum of all Pct values for the Alliance brackets must equal 100.
#
AiPlayerbot.LevelBrackets.Alliance.Range1.Lower = 1
AiPlayerbot.LevelBrackets.Alliance.Range1.Upper = 9
AiPlayerbot.LevelBrackets.Alliance.Range1.Pct   = 6

AiPlayerbot.LevelBrackets.Alliance.Range2.Lower = 10
AiPlayerbot.LevelBrackets.Alliance.Range2.Upper = 19
AiPlayerbot.LevelBrackets.Alliance.Range2.Pct   = 7

AiPlayerbot.LevelBrackets.Alliance.Range3.Lower = 20
AiPlayerbot.LevelBrackets.Alliance.Range3.Upper = 29
AiPlayerbot.LevelBrackets.Alliance.Range3.Pct   = 8

AiPlayerbot.LevelBrackets.Alliance.Range4.Lower = 30
AiPlayerbot.LevelBrackets.Alliance.Range4.Upper = 39
AiPlayerbot.LevelBrackets.Alliance.Range4.Pct   = 9

AiPlayerbot.LevelBrackets.Alliance.Range5.Lower = 40
AiPlayerbot.LevelBrackets.Alliance.Range5.Upper = 49
AiPlayerbot.LevelBrackets.Alliance.Range5.Pct   = 11

AiPlayerbot.LevelBrackets.Alliance.Range6.Lower = 50
AiPlayerbot.LevelBrackets.Alliance.Range6.Upper = 54
AiPlayerbot.LevelBrackets.Alliance.Range6.Pct   = 10

AiPlayerbot.LevelBrackets.Alliance.Range7.Lower = 55
AiPlayerbot.LevelBrackets.Alliance.Range7.Upper = 59
AiPlayerbot.LevelBrackets.Alliance.Range7.Pct   = 14

AiPlayerbot.LevelBrackets.Alliance.Range8.Lower = 60
AiPlayerbot.LevelBrackets.Alliance.Range8.Upper = 60
AiPlayerbot.LevelBrackets.Alliance.Range8.Pct   = 35

##############################################
# Horde Level Brackets Configuration
##############################################
# The following settings define the level brackets for Horde bots. For each bracket, specify:
#
#    AiPlayerbot.LevelBrackets.Horde.RangeX.Lower
#        Description: The lower bound (inclusive) of bracket X.
#
#    AiPlayerbot.LevelBrackets.Horde.RangeX.Upper
#        Description: The upper bound (inclusive) of bracket X.
#
#    AiPlayerbot.LevelBrackets.Horde.RangeX.Pct
#        Description: The desired percentage of Horde bots that should fall into bracket X.
#
# EXAMPLE:
#   The default configuration below defines 9 brackets: Range1 covers levels 1-9, Range2 covers
#   levels 10-19, Range3 covers levels 20-29, and so on.
#
#   To customize or add a new bracket (for example, to isolate level 70 in its own bracket):
#       - Set Range8.Lower = 70 and Range8.Upper = 70, then adjust the Pct values for the adjacent
#         ranges.
#
# NOTE: The sum of all Pct values for the Horde brackets must equal 100.
#
AiPlayerbot.LevelBrackets.Horde.Range1.Lower = 1
AiPlayerbot.LevelBrackets.Horde.Range1.Upper = 9
AiPlayerbot.LevelBrackets.Horde.Range1.Pct   = 6

AiPlayerbot.LevelBrackets.Horde.Range2.Lower = 10
AiPlayerbot.LevelBrackets.Horde.Range2.Upper = 19
AiPlayerbot.LevelBrackets.Horde.Range2.Pct   = 7

AiPlayerbot.LevelBrackets.Horde.Range3.Lower = 20
AiPlayerbot.LevelBrackets.Horde.Range3.Upper = 29
AiPlayerbot.LevelBrackets.Horde.Range3.Pct   = 8

AiPlayerbot.LevelBrackets.Horde.Range4.Lower = 30
AiPlayerbot.LevelBrackets.Horde.Range4.Upper = 39
AiPlayerbot.LevelBrackets.Horde.Range4.Pct   = 9

AiPlayerbot.LevelBrackets.Horde.Range5.Lower = 40
AiPlayerbot.LevelBrackets.Horde.Range5.Upper = 49
AiPlayerbot.LevelBrackets.Horde.Range5.Pct   = 11

AiPlayerbot.LevelBrackets.Horde.Range6.Lower = 50
AiPlayerbot.LevelBrackets.Horde.Range6.Upper = 54
AiPlayerbot.LevelBrackets.Horde.Range6.Pct   = 10

AiPlayerbot.LevelBrackets.Horde.Range7.Lower = 55
AiPlayerbot.LevelBrackets.Horde.Range7.Upper = 59
AiPlayerbot.LevelBrackets.Horde.Range7.Pct   = 14

AiPlayerbot.LevelBrackets.Horde.Range8.Lower = 60
AiPlayerbot.LevelBrackets.Horde.Range8.Upper = 60
AiPlayerbot.LevelBrackets.Horde.Range8.Pct   = 35

##############################################
# Level Reset
##############################################

# Enables the level reset feature.
# Default: 0 (disabled)
AiPlayerbot.ResetBotLevel.Enabled = 0

# The maximum level a bot can reach before being reset.
# Default:     80
# Valid range: 2-80 (or 0 to disable the max-level reset check; SkipFromLevel/SkipToLevel still apply)
AiPlayerbot.ResetBotLevel.MaxLevel = 80

# The level bots will be reset to. For Death Knights, if this is below the heroic starting level,
# they will be reset to the heroic starting level instead.
# Default:     1
# Valid range: 1-79 and < MaxLevel
AiPlayerbot.ResetBotLevel.ResetToLevel = 1

# When a bot reaches exactly this level, it is sent directly to the level specified by SkipToLevel.
# This setting is not affected by ScaledChance or RestrictTimePlayed.
# Default:     0 (disabled)
# Valid range: 1-80 and < MaxLevel (or 0 to disable)
AiPlayerbot.ResetBotLevel.SkipFromLevel = 0

# The level bots will be sent to when they reach SkipFromLevel. For Death Knights, if this is below
# the heroic starting level, they will be reset to the heroic starting level instead.
# Default:     1
# Valid range: 1-80 and <= MaxLevel
AiPlayerbot.ResetBotLevel.SkipToLevel = 1

# The percent chance a bot has to have its level reset when reaching the max level (or the
# configured played time at max level).
# Default:     100
# Valid range: 0-100
AiPlayerbot.ResetBotLevel.ResetChance = 100

# If enabled, the reset chance is (re-)rolled every level-up and scales based on the distance
# between the bot's level and MaxLevel. Bots have a small chance of resetting at lower levels,
# increasing as they approach MaxLevel, where the chance reaches ResetChance.
# Default: 0 (disabled)
AiPlayerbot.ResetBotLevel.ScaledChance = 0

# If enabled, bots at MaxLevel will only have their level reset once they have played at least
# MinTimePlayed seconds at that level.
# Default: 0 (disabled)
AiPlayerbot.ResetBotLevel.RestrictTimePlayed = 0

# If RestrictTimePlayed is enabled, the minimum time (in seconds) a bot must have played at its
# current level before a reset can occur at MaxLevel.
# Default: 86400 (3600 = 1 hour, 86400 = 1 day, 604800 = 1 week)
AiPlayerbot.ResetBotLevel.MinTimePlayed = 86400

# If RestrictTimePlayed is enabled, the frequency (in seconds) at which the played-time check is
# performed for bots at or above MaxLevel.
# Default: 864
# Recommended: 1% of MinTimePlayed, or 300 seconds, whichever is higher.
AiPlayerbot.ResetBotLevel.PlayedTimeCheckFrequency = 864

# When enabled, bots in a guild led by a real (non-bot) player are excluded from level reset
# processing. Backed by the same shared PlayerbotGuildMgr guild cache used by
# AiPlayerbot.LevelBrackets.IgnoreGuildBotsWithRealPlayers (validated at startup and refreshed
# hourly), which also covers offline players; a guild counts as real when its leader is not a
# random-bot account.
# Default: 0 (disabled)
AiPlayerbot.ResetBotLevel.IgnoreGuildBotsWithRealPlayers = 0

# Comma-separated list of bot names to exclude from level reset processing. Names must match the
# character name exactly (character names are stored capitalized, e.g. "Thrall").
# Default: "" (empty)
AiPlayerbot.ResetBotLevel.ExcludeNames =

#
#
####################################################################################################

####################################################################################################
# GEAR
#

# Randombots automatically receive upgraded equipment on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoUpgradeEquip = 1

# Enable/disable which (if any) randombots preserve their current equipment and spec during login
# and periodic randomization (i.e., persistence).
# Default: 1 (enabled)
AiPlayerbot.EquipAndSpecPersistence = 1

# If EquipAndSpecPersistence is enabled, equipment and talent persistence will affect randombots of this
# level or higher.
# Default: 1 (enable persistence for randombots of at least level 1 (i.e., all levels))
AiPlayerbot.EquipAndSpecPersistenceLevel = 1

# Equipment quality limitation for randombots (1 = normal, 2 = uncommon, 3 = rare, 4 = epic, 5 = legendary)
# This also sets the maximum quality that can be generated by autogear for randombots and altbots
# Default: 3 (rare)
AiPlayerbot.RandomGearQualityLimit = 4

# Equipment item level (not gearscore) limitation for randombots (0 = no limit)
# Classic
# Max iLVL Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# Max iLVL Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# TBC
# Max iLVL Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# Max iLVL Phase 1(Kara, Gruul, Mag) = 125 | Phase 2(SSC, TK, ZA) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# WotLK
# Max iLVL Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# Max iLVL Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# Default: 0 (no limit)
AiPlayerbot.RandomGearScoreLimit = 92

# With RandomGearQualityLimit = 4 (epic), the level from which bots may wear epic gear; below it they
# keep to rare. Conquest of Azeroth Worldforged items count as gear of their level, whatever
# LimitGearExpansion says. ".playerbots coa regear [level]" gears the bots online again (game masters).
# Default: 60
AiPlayerbot.CoaEpicGearMinLevel = 60

# Prefer armor of the class's ideal type: apply 3x score multiplier to class-appropriate armor.
# When enabled, Warriors strongly prefer plate, Shamans prefer mail, etc.
# A truly superior item can still win (no hard filtering), but same-quality
# armor of the preferred type will score 3x higher and be equipped instead.
#
# ARMOR TYPE PREFERENCES:
#   Plate:   Warriors, Paladins, Death Knights
#   Mail:    Hunters, Shamans
#   Leather: Rogues, Druids
#   Cloth:   Priests, Mages, Warlocks
#
# Default: 0 (disabled)
AiPlayerbot.PreferClassArmorType = 0

# When enabled, bots prefer spec-appropriate weapons based on speed and weapon type during autogear.
# Examples: Arms Warriors favor slow 2H axes/polearms (Axe Specialization), Combat Rogues
# favor a slow MH with a fast OH, and Enhancement Shamans favor synchronized slow 1H weapons.
# Default: 0 (disabled)
AiPlayerbot.PreferredSpecWeapons = 0

# Set minimum level of bots that will enchant and socket gems into their equipment with maintenance
# If greater than RandomBotMaxlevel, bots will not automatically enchant equipment or socket gems
# Default: 60
AiPlayerbot.MinEnchantingBotLevel = 60

# Enable expansion limitation for bot enchants and gems
# If enabled, bots will not use TBC enchants until level 61 or WotLK enchants and gems until level 71
# Default: 1 (enabled)
AiPlayerbot.LimitEnchantExpansion = 1

# Enable expansion limitation for gear
# If enabled, bots will not equip TBC gear until level 61 or WotLK gear until level 71
# Default: 1 (enabled)
AiPlayerbot.LimitGearExpansion = 1

# Chance randombot will have less-than-optimized generated gear
# Set between 0 (0%) and 1 (100%)
AiPlayerbot.RandomGearLoweringChance = 0.1

# Unobtainable or unusable items (comma-separated list of item IDs)
# Defaults: Chilton Wand (12468), Frenzyheart Insignia of Fury test/on-use row (44869),
#           Oracle Talisman of Ablution test/on-use row (44870), Totem of the Earthen Ring (46978)
AiPlayerbot.UnobtainableItems = 12468,44869,44870,46978

# Randombots check player's gearscore level and deny the group invitation if it's too low
# Default: 0 (disabled)
AiPlayerbot.GearScoreCheck = 0

# Only set wolf pets for hunters for optimal raid performance (0 = disabled, 1 = enabled only for max-level bots, 2 = enabled)
# Default: 0 (disabled)
AiPlayerbot.HunterWolfPet = 0

# Default pet stance when a bot summons a pet
# 0 = Passive, 1 = Defensive, 2 = Aggressive
# Default: 1 (Defensive)
AiPlayerbot.DefaultPetStance = 1

# Enable/disable debug messages about pet commands
# 0 = Disabled, 1 = Enabled
# Default = 0 (disabled)
AiPlayerbot.PetChatCommandDebug = 0

# Prohibit hunter bots from creating pets with any family ID listed below in ExcludedHunterPetFamilies
# See the creature_family database table for all pet families by ID (note: ID for spiders is 3)
AiPlayerbot.ExcludedHunterPetFamilies = ""

#
#
####################################################################################################

####################################################################################################
# ACTIVITY
#

# BotActiveAlone
# - Controls how many bots are active when no real players are nearby.
# - Think of it as a rough percentage: 10 means approximately 10% of bots will be active.
#   Not exact — the actual number may vary slightly per rotation cycle.
# - The active bots rotate: every <DurationSeconds> a different set of bots takes a turn.
# - The real number of active bots will always be higher than this value, because bots in
#   combat, dungeons, battlegrounds, LFG queue, groups with real players, etc. are always
#   forced active on top of this (see force rules below).
# - Set to 100 (with SmartScale off) = all bots always active. Maximum server load.
# - Set to 0 = only bots that match a force rule below will be active.
#
# BotActiveAloneDurationSeconds
# - How often the active roster rotates (in seconds). A different group of bots wakes up
#   and the previous group may go idle.
# - This is a minimum, not exact. If a bot is in combat or meets any force rule when the
#   rotation happens, it stays active until those conditions end — it won't be cut off
#   mid-fight just because its turn expired.
#
# 60 here: measured on a realm of 1000 bots, the value that keeps the world alive without
# spending the map threads on characters nobody is looking at.
AiPlayerbot.BotActiveAlone = 60
AiPlayerbot.BotActiveAloneDurationSeconds = 30

# Force-active rules (1 = on, 0 = off)
# These override the percentage above. If any of these conditions is true, the bot stays active.
#
# InRadius  - A real player is within this many yards (set to 0 to disable).
# InZone    - A real player is in the same zone (e.g. Elwynn Forest).
# InMap     - A real player is on the same continent (e.g. Eastern Kingdoms).
# IsFriend  - A real player has this bot on their friends list.
# InGuild   - This bot is in a guild that has a real player in it.
#
# Bots are also always forced active (not configurable) when:
#   in combat, inside a dungeon/raid/BG, in a BG or LFG queue,
#   grouped with a real player, or controlled by a real player.
#
AiPlayerbot.BotActiveAloneForceWhenInRadius = 150
AiPlayerbot.BotActiveAloneForceWhenInZone = 1
AiPlayerbot.BotActiveAloneForceWhenInMap = 0
AiPlayerbot.BotActiveAloneForceWhenIsFriend = 0
AiPlayerbot.BotActiveAloneForceWhenInGuild = 1

# SmartScale — automatically reduces active bots when the server is struggling.
# Monitors the server's update time (how long each server tick takes in milliseconds).
# When the server slows down, fewer bots are kept active to reduce load.
#
#   Floor (default 50ms)   - Below this, no reduction. Server is running fine.
#   Ceiling (default 200ms) - At or above this, all non-forced bots are paused.
#   Between floor and ceiling, activity scales down gradually.
#     Example: BotActiveAlone=10, floor=50, ceiling=200
#       Server at 50ms  → ~10% active (no reduction)
#       Server at 125ms → ~5% active (half reduction)
#       Server at 200ms → 0% active (only forced bots remain)
#
# MinLevel/MaxLevel — only bots within this level range are affected by SmartScale.
#   Bots outside the range always use the full BotActiveAlone value.
#   Force rules always win over SmartScale.
#
AiPlayerbot.botActiveAloneSmartScale = 1
AiPlayerbot.botActiveAloneSmartScaleDiffLimitfloor = 50
AiPlayerbot.botActiveAloneSmartScaleDiffLimitCeiling = 200
AiPlayerbot.botActiveAloneSmartScaleWhenMinLevel = 1
AiPlayerbot.botActiveAloneSmartScaleWhenMaxLevel = 80

#
#
####################################################################################################

####################################################################################################
# QUESTS
#

# Quests that will be completed and rewarded for all randombots
AiPlayerbot.RandomBotQuestIds = "3802,5505,6502,7761,7848,10277,10285,11492,13188,13189,24499,24511,24710,24712"

# Randombots will group with nearby randombots to do shared quests
# Note: Currently not functioning properly
AiPlayerbot.RandomBotGroupNearby = 0

# Randombots will pick quests on their own and try to complete them
# Default: 1 (enabled)
AiPlayerbot.AutoDoQuests = 1

# Quest items to keep in bots' inventories (do not automatically destroy)
AiPlayerbot.RandomBotQuestItems = "5175,5176,5177,5178,6948,11000,12382,13704,16309"

#
#
####################################################################################################

####################################################################################################
# SPELLS
#

# Randombots automatically learn class quest reward spells on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoLearnQuestSpells = 1

# Randombots automatically learn trainable spells on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoLearnTrainerSpells = 1

# Bots learn every recipe available from tradeskill trainers when the factory
# initialises them. Class trainers are checked against the bot; tradeskill
# trainers are not, so this is where the bulk of a bot's spellbook comes from.
# Turn it off to keep the spellbook - and the in-game `spell` output - limited
# to what the bot can actually cast in combat. Bots then no longer craft.
# Default: 1 (enabled, upstream behaviour)
AiPlayerbot.AutoLearnTradeskillSpells = 1

# Classes the random bots are created with.
# Conquest of Azeroth replaces the nine WotLK classes with twenty-one of its own and shows only those
# on the character creation screen, but the core setting that enforces it, CharacterCreating.Disabled
# .ClassMask in worldserver.conf, ships at 0. On: bots are only created in CoA classes (12 to 32),
# whatever that setting says, so a realm built from source does not fill up with Warriors and Mages
# no player can roll. Off: the upstream behaviour, every class the core allows.
# Bots already created keep their class either way; delete the bot accounts to renew them.
# A Warcraft Reborn realm (CoA.ClassModel = "wcr" in worldserver.conf) ignores this setting: its bots are
# created in the original classes (Warrior to Druid, Death Knight included), each playing one talent tree with
# the Character Advancement build of playerbots_coa_wcr_builds (".playerbots coa wcr", whisper "wcr").
# Default: 1 (enabled)
AiPlayerbot.CoaClassesOnly = 1

# Warcraft Reborn realms only: bots set Mystic Enchants like players at an altar, from the list of their talent tree
# in playerbots_coa_wcr_enchants (taught to them, then placed by the core within level and quality limits). Turning it
# off keeps the enchants already set; delete the bots' rows of coa_mystic_enchant_slot to remove them.
# Default: 1 (enabled)
AiPlayerbot.CoaWcrMysticEnchants = 1

# Gathering bots (herbalism, mining, skinning) only gather what still raises their skill: green, yellow or orange
# for their client, never grey (100 points or more below their skill). One bot can gather everything again with the
# chat command "nc +gather all" ("nc -gather all" to go back).
# Default: 1 (enabled)
AiPlayerbot.GatherOnlySkillUp = 1

# Races of the custom races module (CoA Server Manager) that random bots never use, as race ids separated by
# commas, e.g. "55,63,97". The races that module makes playable (Goblin 9, 12 to 32, 47 to 97) only go to random bots
# when its own setting CoACustomRaces.BotsEnable = 1; CharacterCreating.Disabled.RaceMask (worldserver.conf) only
# reaches ids 1 to 32. Added to AiPlayerbot.CrashingBotRaces below. Also checked when existing random bots enter
# the world: excluded bots stay offline without deleting their characters. Restart after changing these settings.
# Commented out on purpose: the custom races module writes this line itself, and the first copy of a key in a .conf
# file wins, so a line here would hide its own.
# Default: "" (none)
# AiPlayerbot.ExcludedBotRaces = ""

# Custom races never given to random bots, on top of AiPlayerbot.ExcludedBotRaces, from a race by race client test
# (15/10): 32 (Thin Human) and 97 (Saberon) crash a client that sees them, 72 and 77 (Skyborne) have no model in the
# patched client. 65, 80, 81 and 82 showed no crash as bots (Sethrak only crashes when played, at its first login).
# Default: "32,72,77,97"
AiPlayerbot.CrashingBotRaces = "32,72,77,97"

# Authored combat rotations for the Conquest of Azeroth specializations.
# Off: CoA bots are driven by the runtime classifier alone, which picks a spell
# every tick from what the bot knows.
# On: each spec additionally gets the ordered rotation and the position
# generated from its guide, applied through playerbots_custom_strategy.
# The classifier stays active either way, so interrupts, defensive cooldowns
# and the fallback attack are never lost.
# On from v1.4. It was held back while the ordering was only confirmed up to level 40; the whole of
# the 23-24/09 measurement campaign then ran with it on, several hundred arena runs at level 60 on
# two realms, and fourteen rotation lines were corrected against the combat logs of real players.
# Turn it off to fall back on the classifier alone.
# Default: 1 (enabled)
AiPlayerbot.CoaSpecRotations = 1

# Share of its mana a Conquest of Azeroth bot keeps for healing, in percent.
# Under that share it stops paying for damage spells and fights with what costs
# nothing plus its weapon, so that it can still heal when someone drops.
# Measured with 1000 bots: 99% of the casts turned down for want of power were
# made below 10% mana, i.e. bots that had spent everything on damage.
# A bot that knows no heal is never held back. 0 disables the reserve.
# On the maps of AiPlayerbot.RestrictedHealerDPSMaps (with HealerDPSMapRestriction
# on) a healer pays for no damage at all, whatever its mana.
# Default: 35 (bots whose specialization is a healing one)
AiPlayerbot.CoaHealerManaReserve = 35

# The same reserve for every other bot that knows a heal: smaller, since healing
# is not its job, it only has to be able to patch itself up.
# Default: 15
AiPlayerbot.CoaCasterManaReserve = 15

# How a group of a player and bots fares in each fight, written to CoaBots.log when the fight
# ends: time each member spent under 50% and under 25% health, deaths, who received the healing
# and how much was overheal, the healers' mana from the pull to the end, and how long something
# other than the tank was being hit. Only groups with a real player in them are followed.
# Off in the release: it writes a block to the log at the end of every group fight, which is of no
# use to a server owner and costs something on a realm carrying hundreds of bots. Turn it to 1 when
# you want to measure a run, and back to 0 afterwards.
# Default: 0 (disabled)
AiPlayerbot.CoaGroupTelemetry = 0

# Raids too, with AiPlayerbot.CoaGroupTelemetry = 1: one block per raid fight, one line per member.
# The data a raid report needs to tell whether bots are too strong or too weak (ladiabale, 20/10).
# Default: 0 (5-player groups only)
AiPlayerbot.CoaGroupTelemetryRaids = 0

# One line in the log each time a bot changes its target or switches between its combat and out-of-combat engines,
# with the reason when it is known (target dead, out of sight, no attackers left). Made to follow bots that lose
# their enemy behind an arena pillar (ladiabale, 22/10). 0: off. 1: in arenas and battlegrounds. 2: every grouped bot.
# Default: 0 (off)
AiPlayerbot.CoaLogTargets = 0

# In a dungeon or raid a dead bot waits for a resurrection once the fight is over: as long as a living healer of its
# group is on the map, and for at most this many seconds. 0 releases at once when the fight ends; a large value keeps
# bots down for players who raise them with GM commands (ladiabale, 20/10).
# Default: 120
AiPlayerbot.CoaReleaseDelay = 120

# ".playerbots coa raid [size] [tanks] [healers]" fills the raid of the one who types it with bots.
# Game masters have no limit. A player may build one raid every CoaRaidPlayerCooldown minutes, and
# only while the realm has fewer than CoaRaidPlayerMax raids of bots built by players.
# Default: 5 raids at a time, 30 minutes
AiPlayerbot.CoaRaidPlayerMax = 5
AiPlayerbot.CoaRaidPlayerCooldown = 30

# Random bots left in the group of a player who logged out (the core keeps him in a raid, and in a
# party too with LeaveGroupOnLogout.Enabled = 0) stood there with no master until he came back.
# Once none of the group's players has been connected for this many seconds, its random bots leave
# it and go back to their own life; the core disbands the group when the last ones are gone. A
# player who comes back in time keeps his bots, and one in a battleground, an arena or on a loading
# screen still counts as connected. While they wait, the bots are neither moved to another level
# bracket nor randomized or teleported, and a second player still in the group becomes their master.
# Groups of bots only (test benches, random parties), battleground, arena and dungeon finder groups,
# and the players' own bots (alts, addclass bots, selfbots) are never touched. Checked every 10
# seconds, one group released at a time. Read again by ".reload config".
# Default: 300 (0 = the bots stay until their player comes back, as before)
AiPlayerbot.CoaOrphanGroupReleaseDelay = 300

# Bots whisper their master each item they put on by themselves (loot, trade, regear: "Equipping [item]").
# In a raid of 25 bots that is a lot of whispers. An item you ask for (e <item>) is always answered.
# Default: 0 (silent), 1 = whisper every automatic upgrade, as before. Read again by ".reload config".
AiPlayerbot.CoaTellEquipUpgrades = 0

# The CoA core puts every character without a ruleset in PvE at login, so all random bots are in PvE.
# With 1, a share of the random bots is put in High Risk (open world PvP, full loss rules for players;
# bots never lose items) or War Mode instead; the rest stays in PvE. Each bot always gets the same
# ruleset (chosen from its guid). High Risk and War Mode bots keep the PvP flag on (the core only puts the
# aura, so on a PvE realm nobody was flagged by it), and in the open world a bot on its own only starts a
# fight with a High Risk or War Mode character, whatever its own ruleset: as on Ascension, those may be
# attacked by anyone and PvE characters by no one (a bot still defends itself and helps its group).
# In dungeons and raids the ruleset changes nothing, and grouping with
# such a bot does not change yours. 0 = as before (every bot in PvE, bots keep the ruleset they have).
# Read again by ".reload config"; ungrouped bots move at their next update, the others at login.
# CoA Bots 1.9 (PvP): on by default, 30 % of the random bots in High Risk.
AiPlayerbot.CoaRulesetForBots = 1
# Shares, in percent of the random bots, when CoaRulesetForBots = 1 (the rest is PvE).
AiPlayerbot.CoaRulesetHighRiskPct = 30
AiPlayerbot.CoaRulesetWarModePct = 0

# Random bots wear the gear of what they do. PvP gear (resilience) in a battleground, an arena, their queue, and
# for a High Risk bot all the time; PvE gear otherwise, put back as soon as a PvE bot leaves the battleground or
# arena. Grouped with a player, a bot is geared at the player's own item level (a High Risk bot in PvP gear). At
# level 60 and on its own, a PvP bot's tier follows its best arena rating (a fixed tier per bot without one).
# Never the player's own characters. 0 = gear as before.
AiPlayerbot.CoaGearByContent = 1
# With CoaGearByContent = 1. A bot grouped with a player is geared at the player's own item level (never left
# without gear of its level). 0 = a grouped bot keeps the gear it has, as on its own (it still switches to PvP gear
# for a battleground or an arena).
AiPlayerbot.CoaGearMatchGroup = 1
# With CoaGearByContent = 1. High Risk bots wear PvP gear all the time. 0 = only in a battleground or an arena, as
# the other bots (a test server that measures bots on a boss sets 0).
AiPlayerbot.CoaGearHighRiskPvp = 1

# Random bots filled a battleground on a first come, first served basis, whatever their level in the
# bracket: the two sides of a game could start several levels apart, and the higher side won nearly
# every game. Bots of every level still join, but one that would take its side's average level more
# than 2 levels away from the other side's (and further than it is) only joins on this share of its
# tries (and then stays out of that queue for a minute), so the two teams have about the same levels.
# Queues a real player waits in are filled as before.
# In percent; 100 = as before. Read again by ".reload config".
AiPlayerbot.CoaBgLevelBalanceChance = 15

# A snapshot of every random bot online, written as JSON for the SquidBots dashboard (bot-status.json,
# its "botStatusFile" setting): position, health, power, what the bot is doing, its group and its
# quests, shown on the map and on each bot's card. The file is written whole under a .tmp name and
# then renamed, so the dashboard never reads half of it; the dashboard treats it as stale after 60 s.
# With 1000 bots a snapshot takes under a millisecond of the world update (about 300 KB); the disk
# write runs on a thread of its own. "us" and "io_us" in the file give both times in microseconds.
# A relative path is taken from the worldserver's working directory. Empty = not written.
# Read again by ".reload config".
# Default: "" (disabled)
AiPlayerbot.CoaStatusFile = ""

# Seconds between two snapshots of the file above (minimum 1).
# Default: 5
AiPlayerbot.CoaStatusIntervalSeconds = 5

# Healers of Conquest of Azeroth in a group: heal whoever is under 25% health first and
# the tank before the others at equal health, pick the heal for how urgent it is (the
# fastest when someone is dropping, one that fits the missing health otherwise), stay
# within 18 yards of the tank and in its line of sight, keep their mana for healing
# instead of spending it on damage, and tell the group when they run low.
# Read again by ".reload config", so a dungeon can be run with and without it.
# Default: 1 (enabled)
AiPlayerbot.CoaSmartHeal = 1

# Tanks of Conquest of Azeroth: of the enemies hitting someone else, take first the one
# on the healer, then the one on whoever is lowest, rather than the nearest one; a mob
# running away or for help comes last, so the tank no longer follows it into other packs.
# Read again by ".reload config".
# Default: 1 (enabled)
AiPlayerbot.CoaSmartTank = 1

# Bots of Conquest of Azeroth read the casts of dungeon and raid enemies: melee damage
# dealers step out of a point blank cast (Whirlwind, Fire Nova, War Stomp) or from in front of
# a cone (breaths, Arcing Smash) while its cast bar runs, anyone leaves the spot of an area
# cast (Flamestrike), and ranged members keep out of the reach of instant point blank spells
# that the smart_scripts rows of the creature hold. A point blank cast of any nearby enemy, not
# only of the bot's target, is stepped out of too (a boss's Bladestorm while the group kills an
# add). Radius limit: AiPlayerbot.MaxAoeAvoidRadius.
# Takes effect when a bot's strategies are reset (login, ".playerbots bot init", spec change).
# Default: 1 (enabled)
AiPlayerbot.CoaBossKnowledge = 1

# CoA 2.2, ideas taken from other mod-playerbots forks. Each one can be turned off on its own.
# They are read once at start-up (and again by ".reload config").

# Move to regain line of sight in combat. Ranged bots in a group whose target is behind an
# obstacle walk to the nearest group member that can see it, and hold position if none can.
# Melee and solo bots walk towards the target. Healers (CoA healers too) keep the group
# members they cannot see as candidates, at a penalty, and walk until they see them.
# Default: 1 (enabled)
AiPlayerbot.CoaRegainLineOfSight = 1

# A moving bot no longer stops to turn to its target: the movement rewrites its facing every
# update, so "set facing" fired again each tick, above every heal, and healers on the move
# cast nothing.
# Default: 1 (enabled)
AiPlayerbot.CoaNoFacingWhileMoving = 1

# A bot in a fight with an enemy at hand always runs its combat strategies. A healer whose
# target went invalid dropped into the out of combat strategies, where "coa heal" does not
# exist, and healed nobody until something hit it (boss submerged, flying phase).
# Default: 1 (enabled)
AiPlayerbot.CoaKeepCombatEngine = 1

# When its target dies in a fight, a bot attacks the next one in the same update instead of
# going through four updates (drop, assist, reach, face), and a target within 85 degrees of
# its front counts as faced (the game's own test is 90; it was 45).
# Default: 1 (enabled)
AiPlayerbot.CoaNextTargetSameTick = 1

# A CoA healer under 65% health (MediumHealth) heals itself first, unless the member it would
# heal instead is under 45% (LowHealth). With the tank a little lower, the healer was always
# second and died while full of mana.
# Default: 1 (enabled)
AiPlayerbot.CoaHealSelfFirst = 1

# A CoA healer saving its mana stops picking its cheapest heal once the target is under 45%
# (LowHealth) instead of 25% (CriticalHealth): one boss hit took a tank from 45% to dead.
# Default: 1 (enabled)
AiPlayerbot.CoaFastHealBelowLow = 1

# Raid and dungeon target exclusions (Molten Core, Blackwing Lair, Karazhan...) also apply to
# raid marks and to the count of enemies that starts an area attack: a skull on an excluded
# unit no longer overrides them, and excluded units no longer trigger "coa aoe".
# Default: 1 (enabled)
AiPlayerbot.CoaExclusionsEverywhere = 1

# Damage dealers keep their target unless another one is clearly better (dies a quarter sooner,
# or stands 5 yards closer), and the list of attackers comes in a stable order (distance, then
# id): bots no longer flip between two mobs every second and stand still in between.
# Default: 1 (enabled)
AiPlayerbot.CoaStickyTarget = 1

# In dungeons, damage dealers switch to a mob that runs off to fetch help (not a boss, not a
# feared mob) and snares slow it down; a skull mark still comes first, and tanks keep the pack.
# Default: 1 (enabled)
AiPlayerbot.CoaFocusRunners = 1

# A target that steps out of sight for a moment (pillar, wall, a player in the way) is kept:
# the bot walks around instead of dropping the fight and taking the same target back next
# update. Works best with CoaRegainLineOfSight.
# Default: 1 (enabled)
AiPlayerbot.CoaKeepTargetOutOfSight = 1

# In dungeons and raids, out of combat, a routine move (follow, loot, positioning) that would
# end inside the aggro radius of an idle hostile mob is refused: bots no longer pull a pack by
# walking past it. Moves toward the bot's own target, fights and orders are not affected.
# Default: 1 (enabled)
AiPlayerbot.CoaBodyPullGuard = 1

# In a dungeon or raid fight, a bot no longer runs after an enemy farther than healing range
# from the main tank (from its healer, for a tank): casters and melee stopped dying alone at an
# add spawn point. A tank may still fetch an enemy nobody holds yet (the pull).
# Default: 1 (enabled)
AiPlayerbot.CoaChaseLeash = 1

# In a party of five, ranged damage dealers and healers stand behind the living tank (next to
# the healer when it is already back there), step back when they end up on the mob's side,
# and melee close on the tank's side of the mob. Follow between pulls uses the same spot. Works
# with the CoA healer rules (within 18 yards of the tank): the spot is 12 yards behind it.
# Off since 2.3: it could take a player who is not a tank for the group's tank.
# Default: 0 (disabled)
AiPlayerbot.CoaHoldBehindTank = 0

# Real players take the place of random bots, so the world keeps about the same population. Percentage
# of a bot removed per real player online: 100 = one bot fewer per player (500 bots, 40 players online:
# 460 bots), 50 = one bot fewer per two players. Bots leave a few at a time, never while grouped, in a
# dungeon, a battleground, an arena or a queue, and come back when players log out. Your alt bots and
# other bots of a real player are not random bots: never counted, never removed.
# Default: 0 (disabled)
AiPlayerbot.CoaPlayersReplaceBots = 0

# Random bots always kept with CoaPlayersReplaceBots, however many players are online (e.g. 100 keeps
# a hundred bots for the auction house, the battlegrounds and the dungeon finder).
# Default: 0
AiPlayerbot.CoaPlayersReplaceBotsMin = 0

# Dungeon finder: random damage dealers hold back only while a queued party of real players
# still misses a tank or a healer that no queued bot covers. The old test held them back
# whenever a queued player was not tank and healer at once, nearly always, so players waited
# for damage dealers.
# Default: 1 (enabled)
AiPlayerbot.CoaLfgMissingRoles = 1

# CoA 2.3, ideas taken from other mod-playerbots forks. Each one can be turned off on its own.
# They are read once at start-up (and again by ".reload config").

# CoA dispels. A member stunned, feared, polymorphed or silenced by an aura the bot can take off
# is freed first (a healer does it before topping anyone up), healers then tanks before the
# others; a member another bot is already cleansing is left to it. Cleanses laid on the ground
# are cast at the member, cleanses around the caster when the member stands in their radius,
# and a spell that also strikes enemies still cleanses.
# Default: 1 (enabled)
AiPlayerbot.CoaSmartDispel = 1

# CoA bots in a group fight step out of the reach of a member who carries a mark that hurts the
# allies around him (a bomb, a brand, a beacon: an aura that casts or spreads a damaging or
# controlling spell on the carrier's allies in an area, read from the spell data), and a bot that
# carries one steps away from the others. A spell whose damage is meant to be shared is left out.
# Default: 1 (enabled)
AiPlayerbot.CoaAvoidMarkedAlly = 1

# CoA melee specializations in a fight no longer stop at range to cast an attack with a cast time
# or a channel (hybrids stood 20 yards off hardcasting): they close in and use only their instants
# on the way. A rooted bot, or a target it cannot walk to (far above or below), still casts.
# Default: 1 (enabled)
AiPlayerbot.CoaMeleeNoRangedHardcast = 1

# A bot whose bags are full (or, for a random bot, over 80% full) no longer leaves a quest item or
# an item of uncommon quality or better on the corpse: it destroys its cheapest grey item to make
# room for it. Random bots only: the bags of a real player's own bots are never touched.
# Default: 1 (enabled)
AiPlayerbot.CoaLootMakeRoom = 1

# In a dungeon or a raid, a bot no longer casts an area spell (its own AoE, a ground spell, a tank's
# Thunder Clap) that would also hit an attackable creature not yet in combat: the next pack, or the
# spectators of an arena, are no longer pulled by the group's AoE. Outside instances nothing changes.
# Default: 1 (enabled)
AiPlayerbot.CoaAoeNoIdlePull = 1

# Gathering missions for your own characters played as bots (alts): whisper "mission gather [minutes]
# [mining|herbalism]" to the bot, then "mission status" or "mission stop". The bot leaves the group,
# gathers in a zone of its level on its continent, then mails what it gathered to you. Never for
# random bots. A mission resumes when the alt logs in again.
# Default: 1 (enabled)
AiPlayerbot.Missions.Enable = 1

# Longest mission in minutes, and the length when none is given.
# Default: 120 and 60
AiPlayerbot.Missions.MaxMinutes = 120
AiPlayerbot.Missions.DefaultMinutes = 60

# Missions at the same time per player (0 = no limit).
# Default: 3
AiPlayerbot.Missions.MaxPerPlayer = 3

# Deaths before the bot gives up and mails what it has.
# Default: 3
AiPlayerbot.Missions.MaxDeaths = 3

# Teleport the bot to its gathering spot when it makes no progress on the way (else it gives up after
# 3 failures).
# Default: 1 (enabled)
AiPlayerbot.Missions.TeleportFallback = 1

# Teleport the bot straight to its gathering spot when the mission starts, as when you summon an alt: the whole
# mission time is spent gathering. 0: it walks there (the walk counts in the mission time).
# Default: 1 (enabled)
AiPlayerbot.Missions.TeleportToSpot = 1

# Automatic guild bank deposits: a bot in the guild of a real player (your alts, the bots you invited)
# standing near a guild vault puts there the items of the classes below and the gold above KeepGold.
# Never in a guild of random bots, never during a mission, never bound, quest or equipped items.
# The rank of the bot needs the deposit right on the tab.
# Default: 0 (disabled)
AiPlayerbot.GuildBankDeposit.Enable = 0

# Items to deposit, separated by commas: an item class or class:subclass (7 = trade goods, 7:9 = herbs),
# or tradegoods, cloth, leather, ore, herb, meat, elemental, enchanting, parts, gems, reagents, recipes,
# consumables. Empty = gold only.
# Default: tradegoods
AiPlayerbot.GuildBankDeposit.Items = "tradegoods"

# Gold pieces the bot keeps; the rest goes to the guild bank.
# Default: 100
AiPlayerbot.GuildBankDeposit.KeepGold = 100

# Smallest stack deposited (1 = every stack).
# Default: 1
AiPlayerbot.GuildBankDeposit.MinStack = 1

# Guild bank tab (1-6); 0 = the first tabs where the bot may deposit, in order.
# Default: 0
AiPlayerbot.GuildBankDeposit.Tab = 0

# In an arena, a battleground or a duel, a CoA bot stunned, feared, polymorphed or charmed for 2
# seconds or more uses the PvP trinket it wears (spell 42292) to break free. Bots wore it and never
# used it.
# Default: 1 (enabled)
AiPlayerbot.CoaPvpTrinket = 1

# In an arena, CoA bots with a purge (magic buffs, enrages) take them off the enemy players they
# see within 30 yards, their target first, one bot per buff. Until now "coa purge" only worked on
# dungeon bosses and elites (AiPlayerbot.CoaDungeonPriorities).
# Default: 1 (enabled)
AiPlayerbot.CoaArenaPurge = 1

#    AiPlayerbot.CoaTankOpenerSeconds
#        Description: With CoaSmartTank, a CoA damage dealer lets the tank open: on a target no tank
#                     has touched yet it waits at most this many seconds, then goes all out. Read
#                     again by .reload config.
#        Default:     2
#                     0 - no wait

AiPlayerbot.CoaTankOpenerSeconds = 2

#    AiPlayerbot.CoaThreatHold
#        Description: With CoaSmartTank, a CoA damage dealer also holds its attacks on a target where
#                     its threat reaches this percent of the tank's, 20 points more at range (aggro
#                     passes at 110% in melee, 130% at range), while the tank holds that target; an
#                     area attack also waits for the mobs the tank holds around it. Players tanking for
#                     bots in dungeons lost their mobs to damage dealers (jealous-sound #7080).
#        Default:     90
#                     0 - off: holding aggro is the tank's job

AiPlayerbot.CoaThreatHold = 90

#    AiPlayerbot.CoaTankThreatBonus
#        Description: A CoA tank bot causes this much more threat, in percent, through a hidden passive aura
#                     (Increased Threat, 35773): a player dealing heavy damage beside a bot tank kept taking
#                     its mobs. Removed as soon as the bot is no tank any more. Off by default: a tank
#                     wearing its threat auras and playing its rotation should hold aggro on its own.
#        Default:     0 - off
#                     100 - twice the threat

AiPlayerbot.CoaTankThreatBonus = 0

#    AiPlayerbot.CoaAttackLoop
#        Description: 1 - a CoA bot attacks through the same cast path as its heals: a spell refused for
#                     a passing reason (moving, sitting, casting) is set aside 8 seconds instead of a
#                     minute after three refusals, cleaves wait for melee reach, summons are not recast
#                     while up, and area attacks, defensives and interrupts log why they fail.
#                     0 - the attack loop of 1.6.
#        Default:     1

AiPlayerbot.CoaAttackLoop = 1

#    AiPlayerbot.CoaKeepChannels
#        Description: 1 - a CoA bot lets its own attack channel run to its end, one that strikes enemies
#                     and heals no one (Stormflow, Aortic Assault, Twilight Frenzy, Carve): its attacks
#                     and area attacks wait, except the spells the class may cast during that channel
#                     without breaking it (Brine and Electrocute for a Stormbringer during Stormflow),
#                     which its rotation may now cast, as any spell but another channel during a channel
#                     that allows actions (a Barbarian's Berserker). Heals, defensives, taunts,
#                     interrupts and movement still break the channel. Not held: a healing, defensive or
#                     other channel (Mojo Beam, Ripple, Testament of Fortitude), any channel of a healer,
#                     of a bot at critical health, or longer than 15 seconds.
#                     0 - as in 1.6: the next attack breaks the channel once the global cooldown ends.
#                     Read again by .reload config.
#        Default:     1

AiPlayerbot.CoaKeepChannels = 1

#    AiPlayerbot.CoaExclusiveFamilies
#        Description: 1 - of a family of buffs the world database makes exclusive (spell_group_stack_rules:
#                     Stormbringer Aegis and Pressures, Barbarian shouts, Starcaller Aspects), a CoA bot
#                     keeps the member named by the highest priority line of its rotation, in a "buff
#                     missing" or "can cast" trigger or in a cast action; the other lines of the family
#                     wait until it wears none of it, and the kept member never replaces one another
#                     caster put on. "coa buff" leaves that family to the rotation on the bot itself, and
#                     gives the other members of the group a buff of the family when they wear none of it
#                     from the bot, again at once to one who lost it (raised from the dead).
#                     0 - as before: only the families of mod-ascension-compat's aura scripts (Pyromancer
#                     skins, Cultist) are kept to one.
#                     Read again by .reload config.
#        Default:     1

AiPlayerbot.CoaExclusiveFamilies = 1

#    AiPlayerbot.CoaSpellReplacement
#        Description: 1 - checks, cooldowns and the set-aside list follow the spell a proc swaps in
#                     (Malefic Wrath -> Malefic Arrow), the cast keeps the listed id. 0 - as in 1.6.
#        Default:     1

AiPlayerbot.CoaSpellReplacement = 1

#    AiPlayerbot.Coa.AncestralCombatFix
#        Description: 1 - a Barbarian bot that knows the passive Ancestral Combat (801782) without its aura
#                     gets it once, when its fight starts. The core asks for a form no Barbarian takes and
#                     lays the aura only now and then (43 % of the boss bench fights of 02/10), and Ancestry
#                     loses about a third of its damage without it. A stopgap until the core is fixed.
#                     0 - the aura is left to the core.
#                     Read again by ".reload config".
#        Default:     1

AiPlayerbot.Coa.AncestralCombatFix = 1

#    AiPlayerbot.CoaKeepPassiveAuras
#        Description: 1 - when a bot is randomized (level change by the PvP bench or a range, the randomize
#                     timer, init= commands), its passive auras and its positive auras that stay through
#                     death (PvE Mode) are kept; buffs, debuffs and procs go in one pass, as before.
#                     The core lays passives only at login or when a spell is learned anew, and a CoA class
#                     keeps its spells, so without this a randomized bot plays without its passives (Thirst,
#                     stat conversions, procs) until its next login: 0.42 of the damage of a converted bot
#                     of the same spec on the boss bench of 02/10.
#                     0 - all auras are removed, as in 1.6.
#                     Read again by ".reload config".
#        Default:     1

AiPlayerbot.CoaKeepPassiveAuras = 1

#    AiPlayerbot.CoaRatedSoloQueue
#        Description: 1 - while a real player waits in a rated solo queue (1v1, 2v2 or 3v3 with roles), random
#                     bots of their level bracket join it, just enough to complete the matches: healers and
#                     damage dealers as the 2v2 and 3v3 lineups need them. A bot gets a personal arena team
#                     of that bracket, as a player does. The role of a real player is read from their spec.
#                     0 - bots never join the rated solo queues.
#                     Read again by ".reload config".
#        Default:     1

AiPlayerbot.CoaRatedSoloQueue = 1

#    AiPlayerbot.CoaRatedSoloRoleFallback
#        Description: seconds a real player waits in a rated solo 2v2 or 3v3 queue, bots already queued with
#                     them and no match started, before their role is taken for the other one: one more bot,
#                     a healer if they were read as a damage dealer and a damage dealer if read as a healer,
#                     once per wait. A bot no lineup needs leaves the queue after its usual wait.
#                     0 - never. Read again by ".reload config".
#        Default:     40

AiPlayerbot.CoaRatedSoloRoleFallback = 40

#    AiPlayerbot.CoaArenaReady
#        Description: 1 - an arena shows a ready pylon in each starting room, as on the original CoA realm.
#                     A player clicks it when ready; a bot is ready by itself once settled. When every
#                     combatant is ready, the preparation drops to AiPlayerbot.CoaArenaReadyCountdown seconds.
#                     0 - the full preparation time, as before.
#                     Read again by ".reload config".
#        Default:     1

AiPlayerbot.CoaArenaReady = 1

#    AiPlayerbot.CoaArenaReadyCountdown
#        Description: seconds left before the gates open once everyone is ready.
#        Default:     6

AiPlayerbot.CoaArenaReadyCountdown = 5

#    AiPlayerbot.CoaArenaReadyBotDelay
#        Description: seconds a bot waits after it enters the arena (gear, buffs, pet) before it is ready.
#        Default:     10

AiPlayerbot.CoaArenaReadyBotDelay = 10

#    AiPlayerbot.CoaArenaReadyEntry
#    AiPlayerbot.CoaArenaReadyDisplay
#        Description: gameobject template spawned as the pylon (a clickable object without lock or script)
#                     and an optional display id to give it another look (0 - the template's own).
#        Default:     184615, 0

AiPlayerbot.CoaArenaReadyEntry = 184615
AiPlayerbot.CoaArenaReadyDisplay = 0

#    AiPlayerbot.CoaArenaReadyScale
#        Description: size of the pylon (the default crystal is far taller than a player at 1).
#        Default:     0.5

AiPlayerbot.CoaArenaReadyScale = 0.5

#    AiPlayerbot.CoaArenaReadyDistance
#        Description: yards from the team start point towards the other team, where the pylon stands.
#        Default:     5

AiPlayerbot.CoaArenaReadyDistance = 6

#    AiPlayerbot.CoaArenaReadySide
#        Description: yards to the right of that line (negative: to the left), out of the way to the gate.
#        Default:     3

AiPlayerbot.CoaArenaReadySide = 3

#    AiPlayerbot.CoaArenaReadyHeight
#        Description: yards above the ground the pylon floats (the crystal sinks halfway into the floor at 0).
#        Default:     1.2

AiPlayerbot.CoaArenaReadyHeight = 1.2

#    AiPlayerbot.CoaArenaRoleSpot
#        Description: 1 - in an arena a CoA bot takes the spot of its role before the fight (healers at the back,
#                     ranged in the middle, melee and tanks in front). 0 - all CoA bots take the melee spot, as
#                     before (they all share class id 27). Every CoaArena*, CoaPvp* and CoaDuel* switch below is
#                     read again by ".reload config".
#        Default:     1

AiPlayerbot.CoaArenaRoleSpot = 1

#    AiPlayerbot.CoaArenaPreparation
#        Description: 1 - before the gates open, a CoA bot takes a place of its role in its starting room, between
#                     the start point and the gate (healers at the back, ranged in the middle, melee in front, side
#                     by side), faces the gate, then keeps its buffs and pet up. It never leaves the room, stays on
#                     the Ring of Valor lift, and is still marked ready (AiPlayerbot.CoaArenaReady).
#                     0 - the bots wait on their start point.
#        Default:     1

AiPlayerbot.CoaArenaPreparation = 1

#    AiPlayerbot.CoaArenaLineOfSight
#        Description: 1 - in an arena, a CoA ranged bot or healer whose target (or most hurt team member) is out of
#                     sight steps to the nearest reachable point that sees it from casting range, away from enemy
#                     melee, or joins a team member who sees it. 0 - it walks onto the target's spot, as before.
#        Default:     1

AiPlayerbot.CoaArenaLineOfSight = 1

#    AiPlayerbot.CoaArenaCover
#        Description: 1 - the CoA arena moves (kiting, hiding when under pressure, running after a crowd control)
#                     know the pillars of each arena: found once per arena map by a walk over its floor (written
#                     to the log as "coa arena cover: ..." to check them in game), plus the Ring of Valor pillars
#                     and the Dalaran waterfall the core spawns as objects. 0 - they only try points around the bot.
#        Default:     1

AiPlayerbot.CoaArenaCover = 1

#    AiPlayerbot.CoaArenaKite
#        Description: 1 - in an arena, a CoA ranged bot or healer with an enemy melee on it steps 7 to 11 yards
#                     away (towards a pillar when one is near), staying within casting range and sight of its
#                     target or of the most hurt team member; at most 5 seconds of steps, then 6 seconds of
#                     fighting before it kites again. Arenas only. 0 - it stands in the melee, as before.
#        Default:     1

AiPlayerbot.CoaArenaKite = 1

#    AiPlayerbot.CoaArenaFocus
#        Description: 1 - in an arena, a CoA damage dealer goes for the enemy healer it sees within reach (35 yards
#                     from range, 25 in melee), else for the most hurt enemy it sees; it finishes a target under
#                     25% and switches at most every 4 seconds ("dps assist" waits meanwhile). 0 - as before.
#        Default:     1

AiPlayerbot.CoaArenaFocus = 1

#    AiPlayerbot.CoaArenaPeel
#        Description: 1 - in an arena, a CoA tank (or a melee damage dealer once its healer is under 60%) turns on
#                     the enemy hitting its team's healer and puts a crowd control on it, every 12 seconds at most.
#        Default:     1

AiPlayerbot.CoaArenaPeel = 1

#    AiPlayerbot.CoaArenaPressure
#        Description: 1 - in an arena, a CoA ranged bot or healer under 45% health that enemies aim at hides from
#                     the casters among them (behind a pillar, preferably still in sight of its own healer), or
#                     falls back behind its tank or melee team mate when only melee are on it. 6 seconds at most,
#                     then 10 seconds before it hides again.
#        Default:     1

AiPlayerbot.CoaArenaPressure = 1

#    AiPlayerbot.CoaDuelOpening
#        Description: 1 - during the duel countdown, a CoA melee bot closes in to 3.5 yards and a ranged bot or
#                     healer steps back to 20 yards (in sight, near the duel flag), then faces the opponent and
#                     refreshes its buffs. Works in the .coapvp duel bench too (the held duellist does not move;
#                     the distance logged at the start of a bench duel grows for ranged bots).
#                     0 - both stay where the challenge left them, as before.
#        Default:     1

AiPlayerbot.CoaDuelOpening = 1

#    AiPlayerbot.CoaPvpRecovery
#        Description: 1 - in a duel, arena or battleground, a CoA bot under 40% health with an enemy player in its
#                     face puts a crowd control on it (every 20 seconds at most), then runs 9 to 14 yards away for
#                     up to 4 seconds, out of the enemy's sight when it can. 0 - as before.
#        Default:     1

AiPlayerbot.CoaPvpRecovery = 1

#    AiPlayerbot.CoaPvpBandage
#        Description: 1 - in a duel, arena or battleground, a CoA bot under 65% health bandages itself when it
#                     carries a bandage it has the First Aid for and no free enemy can reach it (held, out of
#                     sight or far); never while Recently Bandaged, under a damage over time, moving or eating.
#                     Eating and drinking between fights stay with the "food" strategy.
#        Default:     1

AiPlayerbot.CoaPvpBandage = 1

#    AiPlayerbot.CoaShortLivedDebuffs
#        Description: life a target must have left (its health over the estimated damage of the group)
#                     for the rotation lines "debuff missing::<spell>" and "cast debuff::<spell>".
#                     0 - 8 seconds for every spell, as in 1.6. A trial or trash creature never lives that
#                     long, so these lines never fire there (7 of the 64 lines of the web DPS rotations on
#                     the dungeon trials of 02-03/10: no Conjure Storm, Melt Reality, Unmake, Earthquake...).
#                     1 - half the duration of the debuff, 8 seconds at most (a DoT of 16 s or more keeps
#                     8 s, Unmake of 1.5 s needs 0.75 s); 2 seconds at most when the spell also hits at once;
#                     and for a spell that strikes an area, the health of the enemies inside the area is
#                     counted, not that of the target alone. Boss fights hardly change (a boss lives long).
#                     2 - as 1, for the bots whose GUID is a multiple of 4 only: half of the even-GUID
#                     bots of the A/B bench, the other half (GUID % 4 = 2) keeps 8 s and serves as control.
#                     Only the CoA lines above; the class strategies of the nine base classes keep 8 s.
#                     Read again by ".reload config".
#        Default:     0

AiPlayerbot.CoaShortLivedDebuffs = 0

#    AiPlayerbot.CoaAttackCheckBench
#        Description: with AiPlayerbot.CoaAttackLoop = 1, what becomes of an attack the strict check turns
#                     down (target or caster aura missing, bad target, short of rage, energy or mana).
#                     0 - skipped for this tick only, as in 1.6: the next tick tries it again.
#                     1 - set aside 20 seconds (5 when short of power), as heals are.
#                     A stunned bot sets its attacks aside either way.
#        Default:     0

AiPlayerbot.CoaAttackCheckBench = 0

#    AiPlayerbot.CoaStealthIsNotStance
#        Description: 1 - a stealth or an invisibility the bot casts on itself (Ranger Elude, Venomancer
#                     Skulk, Reaper Underwalk, Runemaster Runeshroud) no longer counts as a stance: out of
#                     combat the bot stops wearing it, so it no longer walks slowed and hidden in towns or
#                     between trial waves, and takes its real stance (quiver, form, tattoo) instead. A
#                     rotation can still cast it by name. Spells that need it (Flank, Toxic Dart, Spectre
#                     Stride, Palm Sigils) then only come with a proc or a stealth cast in the fight.
#                     0 - stealth is a stance like any other, as in 1.6.
#                     Read once, when the first bot loads: a restart is needed to change it.
#        Default:     0

AiPlayerbot.CoaStealthIsNotStance = 0

#    AiPlayerbot.CoaInterruptCoordination
#        Description: 1 - in a group, one bot kicks each enemy cast: the first to see it picks a bot
#                     with a kick ready and in reach, a damage dealer before a healer before the tank,
#                     the one that kicked longest ago first; the others hold theirs until the kick has
#                     landed. In a dungeon a routine cast is let through when only one kick is left in
#                     reach, kept for a heal, crowd control or long cast. Kicks are only tried on casters
#                     they reach. Bots without a group are not affected; real players are never counted on.
#                     0 - every bot kicks the first cast it sees, as in 1.6. Either way CoaBots.log counts
#                     the enemy casts seen and kicked and the kicks wasted on a cast already kicked.
#                     Read again by ".reload config".
#        Default:     1

AiPlayerbot.CoaInterruptCoordination = 1

#    AiPlayerbot.CoaDungeonPriorities
#        Description: 1 - bots deal first with what keeps the enemy going, as players do: they kick a heal,
#                     crowd control or summon before an ordinary cast (and a short list of classic dungeon
#                     boss casts before anything else); in a dungeon they also take a magic buff or an
#                     enrage off a boss or elite with their purge or soothe, and damage dealers switch to
#                     a totem, ward or add that heals or shields its side (tanks keep the boss). The
#                     "coa dungeon:" lines of Playerbots.log show each kind of decision once a minute.
#                     0 - none of it, as in 1.9.
#                     Read again by ".reload config".
#        Default:     1

AiPlayerbot.CoaDungeonPriorities = 1

# Conquest of Azeroth specializations bots never play, by id, comma separated. A bot holding one
# switches to another of its role, and ".playerbots coa" never recruits one.
# Empty by default: no specialization is worth setting aside as things stand. The two that used to be
# here were measured again on 23/09 over a hundred arena runs and both earned their place back --
# Venomancer Vizier (101) heals 122 a second, fourth of nine healers and the fewest deaths of the
# leading group, its scarab form no longer blocking its heals; Tinker Invention (51) heals 102 a
# second, last but one, no longer the silent healer of 21/09.
# Set it when a specialization is broken beyond what the bot can be taught, and write the reason and
# the date here, so that it is reconsidered rather than forgotten.
#    99 Bloodmage Eternal: the cursed form Eternal Curse (92114) is granted by nothing in the core,
#       so every ability of the specialization fails with SPELL_FAILED_CASTER_AURASTATE. Measured
#       24/09 over ten arena runs at level 60: 0 taunts, 90 damage a second where the other eleven
#       tanks do 289 to 668, and 4.2 group deaths a run, the worst of the twelve. Nothing on the bot
#       side can repair it. Take it out again once the form is granted.
#       10/10: tried again (the core grants the form since jealous-sound#5655): still broken on the tank
#       bench, 12 to 53% of the fight held, Scarlet Delirium cast 80 times in 3 minutes and almost nothing else.
# Read again by ".reload config".
# Default: 99
AiPlayerbot.CoaExcludedSpecializations = 99

#    AiPlayerbot.CoaOffensiveHealerSpecs
#        Description: Healer specializations whose damage is their healing: they keep dealing damage
#                     whatever their mana (the healer mana reserve would take their heals away).
#                     Read again by .reload config.
#        Default:     40,43 (Cultist Heretic, Starcaller Moon Priest)

AiPlayerbot.CoaOffensiveHealerSpecs = 40,43

#    AiPlayerbot.CoaMeleeHealerSpecs
#        Description: Healer specializations played in melee: they fight on the tank's target, within reach of
#                     their melee heals, instead of from range like the other healers.
#                     Empty: every healer stays at range. Applies at the next login or strategy reset.
#        Default:     40 (Cultist Heretic)

AiPlayerbot.CoaMeleeHealerSpecs = 40
#    AiPlayerbot.ZoneCrowdLimit
#        Description: When a random bot is sent to a leveling spot, zones that already hold this many random bots
#                     of about its level (5 levels either way) are left out, so that bots spread over the zones of
#                     their level instead of piling up in the same ones. When every zone is that crowded, the
#                     bot goes anyway. 0: off.
#        Default:     30

AiPlayerbot.ZoneCrowdLimit = 30

#
#    AiPlayerbot.CoaHealsExcluded
#        Description: Heals a bot must not consider, by their English name, separated by commas.
#                     A bot builds its heal kit from every heal it knows, not from its rotation:
#                     this is the only place that makes it forget a spell. The spell keeps all its
#                     other effects, it merely stops counting as a heal. Read once at startup, when
#                     each class's spell table is built, so it costs nothing in play.
#                     Needs a restart, not .reload config.
#        Default:     Nanobot Reconstruction (Tinker) - its own description reads "healing for 0",
#                     and measurement agrees: 4724 mana for 76 points of useful healing.
#                     Leave empty to set nothing aside.
#

AiPlayerbot.CoaHealsExcluded = "Nanobot Reconstruction"

#
#    AiPlayerbot.CoaBotSurname
#        Description: The surname random bots carry after their first name.
#                     1: the fixed surname of AiPlayerbot.CoaBotSurnameText ("Kegarink Bot"), so
#                        players tell bots from real players at a glance: nameplates, tooltips, chat, /who.
#                     2: a lore-style family name of the bot's race, drawn once and kept
#                        ("Kegarink Bloodfang", "Elarian Moonwhisper", "Thurgin Stonebeard").
#                     Applied to existing bots at the next start: 0 takes the surnames back, 1 puts the
#                     fixed one on every bot, 2 draws one for each bot that has none or the fixed one.
#                     Needs a client that shows two-word names (CoA client revision 8 or later).
#                     To whisper a bot by typing its name: /w "Kegarink Bot" hello
#        Default:     1 - fixed surname
#                     2 - surname drawn for the bot's race
#                     0 - off

AiPlayerbot.CoaBotSurname = 1

#
#    AiPlayerbot.CoaBotSurnameText
#        Description: The fixed surname of AiPlayerbot.CoaBotSurname = 1. One word of 2 to 12 letters that
#                     passes the realm's name rules; anything else falls back to "Bot". Changing it renames
#                     the bots at the next start.
#        Default:     "Bot"

AiPlayerbot.CoaBotSurnameText = "Bot"

#
#    AiPlayerbot.CoaRecruitSameFaction
#        Description: Bots recruited by a player (lfg bot, .playerbots coa tank|heal|dps, the
#                     SquidBots buttons) are of the player's faction, even on a realm that allows
#                     cross-faction groups (AllowTwoSide.Interaction.Group = 1): a bot of the other
#                     faction is attacked by the guards and faction creatures on the way, and does
#                     not understand what the player says in party chat.
#        Default:     1 - the player's faction only
#                     0 - any faction when the realm allows cross-faction groups

AiPlayerbot.CoaRecruitSameFaction = 1

#
#    AiPlayerbot.CoaLfgBots
#        Description: Bots answer players looking for a group in chat. A player who says
#                     "lfg bot heal", "lfg bot tank", "lfg bot dps", "lfg bot heal tank dps" or just
#                     "lfg bot" (every role) in a listened channel is whispered by free bots of its
#                     faction able to play those roles, with their class, specialization and level.
#                     The player invites the ones it wants; an invited bot joins at once and
#                     teleports next to the player (into its dungeon if need be). For realms where
#                     /who hides the bots. Read again by .reload config, as are the settings below.
#        Default:     1 - on
#                     0 - off

AiPlayerbot.CoaLfgBots = 1

#    AiPlayerbot.CoaLfgChannels
#        Description: Comma separated names of the chat channels listened to. A channel whose name
#                     starts with one of them is heard: "General" covers "General - Elwynn Forest".
#                     The client's channel numbers (/1, /2...) differ from player to player, the names
#                     do not. Usual names: General, Trade, LocalDefense, LookingForGroup, World.
#        Default:     General,LookingForGroup,World

AiPlayerbot.CoaLfgChannels = Zone,Newcomers,World

#    AiPlayerbot.CoaLfgRequireBotWord
#        Description: Whether the request must contain the word "bot". Off, "lfg heal" said by a
#                     player looking for other players is answered by bots too.
#        Default:     1 - "lfg bot heal" only
#                     0 - "lfg heal" as well

AiPlayerbot.CoaLfgRequireBotWord = 1

#    AiPlayerbot.CoaLfgTankOffers, AiPlayerbot.CoaLfgHealOffers, AiPlayerbot.CoaLfgDpsOffers
#        Description: How many bots whisper an offer for each role asked for (0 to 5). Different
#                     classes when there are some.
#        Default:     2, 2, 3

AiPlayerbot.CoaLfgTankOffers = 2
AiPlayerbot.CoaLfgHealOffers = 2
AiPlayerbot.CoaLfgDpsOffers = 3

#    AiPlayerbot.CoaLfgLevelRange
#        Description: A bot within this many levels of the player keeps its level and gear; one
#                     further away is rebuilt at the player's level (gear, talents, spells) before it
#                     whispers.
#        Default:     2

AiPlayerbot.CoaLfgLevelRange = 2

#    AiPlayerbot.CoaLfgOfferMinutes
#        Description: How long an offer holds: meanwhile the bot is offered to nobody else and
#                     accepts that player's invitation. Afterwards it goes back to its own life.
#        Default:     2

AiPlayerbot.CoaLfgOfferMinutes = 2

#    AiPlayerbot.CoaLfgCooldown
#        Description: Seconds before the same player is answered again for the same role.
#        Default:     30

AiPlayerbot.CoaLfgCooldown = 15

#    AiPlayerbot.CoaLfgAnnounceMinutes
#        Description: Every so many minutes, a message to the whole realm on how to ask the bots.
#        Default:     10
#                     0 - never

AiPlayerbot.CoaLfgAnnounceMinutes = 10

#    AiPlayerbot.CoaLfgAnnounceText
#        Description: That message. Empty: "[SquidBots] Need a healer, a tank or damage? Say lfg bot
#                     heal, lfg bot tank, lfg bot dps or lfg bot heal tank dps in the General or
#                     LookingForGroup channel, then invite the bots that whisper you."
#        Default:     (empty)

AiPlayerbot.CoaLfgAnnounceText =

# Write the rare finds of the bots to the "playerbots.loot" logger.
# Off by default: the hook runs on every bot loot, so a server that does not want
# the lines should not pay for reading the item. Turn this on together with a
# worldserver.conf logger that points "playerbots.loot" at an appender.
# Default: 0 (disabled)
AiPlayerbot.LootLog = 0

# Quality a looted item must reach to be written to the "playerbots.loot" logger:
# 3 rare (blue), 4 epic, 5 legendary. Only used when AiPlayerbot.LootLog is on;
# only bots are ever logged.
# Epics alone are far too rare to watch: a thousand bots grinding their way to 60
# find a handful a day, where blues arrive all the time.
# Default: 3 (rare)
AiPlayerbot.LootLogMinQuality = 3

# Randombots automatically spend talent points on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoPickTalents = 1

# Altbots (your own characters added as bots) spend their free talent points by themselves, on levelup and when
# they log in: CoA classes along their specialization's level build, other classes with the talent template of
# their main tree. Points already spent are kept: nothing is lowered, reset or swapped, and a free choice you made
# stays yours. "talents autopick" does the same on demand. Off by default: it spends points on players' own
# characters; set it to 1 on a server of your own.
# Default: 0 (disabled)
AiPlayerbot.AutoPickTalentsAltBots = 0

# Spells every randombot will learn automatically and every altbot will learn with maintenance
# Default: 54197 (Cold Weather Flying)
AiPlayerbot.RandomBotSpellIds = "54197"

# ID of spell to open lootable chests
AiPlayerbot.OpenGoSpell = 6477

#
#
####################################################################################################

####################################################################################################
# STRATEGIES
#

# Additional randombot strategies
# Strategies added here are applied to all randombots, in addition (or subtraction) to spec/role-based default strategies.
# These rules are processed after the defaults.
# Example: "+threat,-potions"
AiPlayerbot.RandomBotCombatStrategies = ""
AiPlayerbot.RandomBotNonCombatStrategies = ""

# Additional altbot strategies
# Strategies added here are applied to all altbots, in addition (or subtraction) to spec/role-based default strategies.
# These rules are processed after the defaults.
AiPlayerbot.CombatStrategies = ""
AiPlayerbot.NonCombatStrategies = ""

# Remove "healer dps" strategy on the maps specified below.
# Default: 1 (enabled)
AiPlayerbot.HealerDPSMapRestriction = 1

# List of Map IDs where "healer dps" strategy will be removed if AiPlayerbot.HealerDPSMapRestriction is enabled
# Default: (Dungeon and Raid maps) "33,34,36,43,47,48,70,90,109,129,209,229,230,329,349,389,429,1001,1004,1007,269,540,542,543,545,546,547,552,553,554,555,556,557,558,560,585,574,575,576,578,595,599,600,601,602,604,608,619,632,650,658,668,409,469,509,531,532,534,544,548,550,564,565,580,249,533,603,615,616,624,631,649,724"
AiPlayerbot.RestrictedHealerDPSMaps = "33,34,36,43,47,48,70,90,109,129,209,229,230,329,349,389,429,1001,1004,1007,269,540,542,543,545,546,547,552,553,554,555,556,557,558,560,585,574,575,576,578,595,599,600,601,602,604,608,619,632,650,658,668,409,469,509,531,532,534,544,548,550,564,565,580,249,533,603,615,616,624,631,649,724"

#
#
####################################################################################################

####################################################################################################
# RPG STRATEGY
#

# Randombots will behave more like real players (experimental)
# This option will override AiPlayerbot.AutoDoQuests, RandomBotTeleLowerLevel, and RandomBotTeleHigherLevel
# Default: 1 (enabled)
AiPlayerbot.EnableNewRpgStrategy = 1

# Control probability weights for RPG status of bots. Takes effect only when the status meets its premise.​
# Sum of weights need not be 100. Set to 0 to disable the status.
#
# WanderRandom  (Default: 15  Move randomly nearby to find and kill mobs)
# WanderNpc     (Default: 20  Randomly interact with nearby NPCs​)
# GoGrind       (Default: 15  Go to nearby level-appropriate locations to grind for killing mobs)
# GoCamp        (Default: 10  Return to a nearby camp depending on innkeeper/flightmaster)​
# DoQuest       (Default: 60  Select quest from the quest log and head to the location to attempt completion​)
# TravelFlight  (Default: 15  Go to the nearest flightmaster and fly to a level-appropriate area)
# Rest          (Default: 5   Take a break for a while and do nothing)
# OutdoorPvp    (Default: 10  Participate in outdoor PvP capture points if already in an outdoor PvP zone)
# GoCity        (Default: 10  Visit a capital of the bot's faction for a while (see CoaCityStay below): bank,
#                             auction house, inn, trainers and vendors; bots too far away (from level 10) teleport
#                             there and back. Never a bot in a group, a queue, an instance or High Risk)
AiPlayerbot.RpgStatusProbWeight.WanderRandom = 15
AiPlayerbot.RpgStatusProbWeight.WanderNpc = 20
AiPlayerbot.RpgStatusProbWeight.GoGrind = 15
AiPlayerbot.RpgStatusProbWeight.GoCamp = 10
AiPlayerbot.RpgStatusProbWeight.DoQuest = 60
AiPlayerbot.RpgStatusProbWeight.TravelFlight = 15
AiPlayerbot.RpgStatusProbWeight.Rest = 5
AiPlayerbot.RpgStatusProbWeight.OutdoorPvp = 10
AiPlayerbot.RpgStatusProbWeight.GoCity = 10

# How long a bot on a city visit (GoCity above) stays among the city NPCs, in minutes: a random time between the
# two. Both are read again by ".reload config", like the GoCity weight.
# Default: 10 and 30
AiPlayerbot.CoaCityStayMinMinutes = 10
AiPlayerbot.CoaCityStayMaxMinutes = 30

# City duels: a few free random bots duel in front of the main gate of Orgrimmar (Horde bots) and of Stormwind
# (Alliance bots), pairs of close levels, one duel after another; they go back to their random life after a while.
# Never bots in a group, with a master, in a queue, a battleground or an instance; no new duel while a real player
# of the other faction is near. All read again by ".reload config".
#    Enable           1 = on (default), 0 = off: the duellists go back at once.
#    BotsPerCity      Duellists per city, two per duel (default 6, at most 12).
#    PairLevels       Wanted level of each pair, in turn (default "60,60,30"); the nearest free bots are taken.
#    PairLevelGap     Most levels between the two bots of a pair (default 2).
#    MinLevel         Lowest level taken (default 10).
#    RotationMinutes  A pair is replaced by two other bots after this time (default 20).
#    RestSeconds      Pause between two duels of a pair (default 15).
#    UpdateSeconds    How often the duels are looked after (default 5).
#    OrgrimmarSpot / StormwindSpot  "map x y z orientation" of the middle pair, the others in a row along the
#                     orientation, 10 yards apart; empty = outside the main gate.
AiPlayerbot.CityDuels.Enable = 1
AiPlayerbot.CityDuels.BotsPerCity = 6
AiPlayerbot.CityDuels.PairLevels = "60,60,30"
AiPlayerbot.CityDuels.PairLevelGap = 2
AiPlayerbot.CityDuels.MinLevel = 10
AiPlayerbot.CityDuels.RotationMinutes = 20
AiPlayerbot.CityDuels.RestSeconds = 15
AiPlayerbot.CityDuels.UpdateSeconds = 5
AiPlayerbot.CityDuels.OrgrimmarSpot = ""
AiPlayerbot.CityDuels.StormwindSpot = ""

